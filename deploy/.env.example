# Копируйте в .env и подставьте свои значения.
# Файл .env не коммитится в git.
#
# На VPS обязательно укажите реальный внешний IP в PUBLIC_IPV4,
# иначе TURN не будет работать для клиентов из интернета.

APP_ENV=prod
SIGNALING_PORT=8080
SESSION_TTL_SEC=300
MAX_JOIN_ATTEMPTS=5
LOCK_MINUTES=10
TURN_REALM=zconect.local
TURN_USER=zconect
TURN_PASS=change_me
# Для VPS подставьте ваш публичный IPv4 (не 127.0.0.1):
PUBLIC_IPV4=127.0.0.1
# Comma-separated list of allowed WebSocket origins (CSRF protection).
# Empty = allow all (dev mode). In production, set to your domain(s).
# ALLOWED_ORIGINS=https://your-domain.com,https://app.your-domain.com
ALLOWED_ORIGINS=
# Dashboard API key (empty = dashboard disabled).
# Access: http://your-server:8080/dashboard?key=YOUR_KEY
DASHBOARD_API_KEY=
