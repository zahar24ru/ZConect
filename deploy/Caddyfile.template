# Caddy reverse proxy config для ZConect signaling server.
#
# Auto-generated by deploy_setup.ps1 / deploy_fast.ps1 из шаблона:
#   __SIGNALING_DOMAIN__  → твой subdomain (например connect.zconn.ru)
#   __ADMIN_EMAIL__       → email для Let's Encrypt renewal notifications
#
# Что обеспечивает:
#   - Automatic Let's Encrypt TLS cert (ACME HTTP-01 через 80 port)
#   - HTTP → HTTPS redirect (permanent 301)
#   - WebSocket upgrade для /ws (wss://)
#   - HTTP/2 + HTTP/3 из коробки
#   - HSTS header с 1 year max-age
#   - Gzip compression для JSON responses
#   - Proxy headers (X-Forwarded-For, X-Real-IP) для TRUSTED_PROXIES=caddy
#   - Static landing page (/) с live uptime + status badges
#   - API/WS/Admin роутятся на signaling:8080, всё остальное → static

{
	# Global config block
	email __ADMIN_EMAIL__
	# Prod mode: use Let's Encrypt production CA (default). Для testing — staging.
	# acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
}

__SIGNALING_DOMAIN__ {
	# ─── TLS — Let's Encrypt automatic ────────────────────────────
	# Caddy сам fetches cert при первом запросе, renew за 30 дней до expiry.
	# Cert сохраняется в volume /data (persistent).

	# ─── Security headers ────────────────────────────────────────
	header {
		# HSTS — 1 year, включая subdomains. После первого HTTPS hit браузеры
		# больше не позволят HTTP downgrade. ТОЛЬКО когда уверен что cert работает!
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# Clickjacking protection
		X-Frame-Options "DENY"
		# MIME sniffing protection
		X-Content-Type-Options "nosniff"
		# Referrer policy
		Referrer-Policy "strict-origin-when-cross-origin"
		# Убираем Server banner
		-Server
	}

	# ─── Compression ─────────────────────────────────────────────
	encode gzip

	# ─── Routing: API/WS/Admin → signaling backend, всё остальное → static ───
	# Порядок matter'ит в Caddy: более специфичные matcher'ы должны быть раньше.
	# Use handle blocks для exclusive routing (только один match'нется).

	# API endpoints → Go signaling
	handle /api/* {
		reverse_proxy signaling:8080 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			flush_interval -1
		}
	}

	# WebSocket → Go signaling (upgrade handled Caddy'ем автоматически)
	handle /ws* {
		reverse_proxy signaling:8080 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			flush_interval -1
			# Bug fix 2026-04-27: WebSocket idle timeouts.
			# Default Caddy net/http.Transport имеет IdleConnTimeout=90s и
			# ResponseHeaderTimeout. Для long-lived WebSocket sessions это
			# создаёт problem — Caddy закрывает idle upstream connection даже
			# если client активно ping'ает (control frames не "видны" Caddy
			# как HTTP traffic после Upgrade).
			# Симптом из user logs: peer_disconnected каждые 30-90 sec несмотря
			# на server-side SetPingHandler/SetPongHandler keepalive.
			# Fix: read_timeout 0 + write_timeout 0 = no timeout для WS proxy.
			# dial_timeout оставляем 5s для initial connect.
			transport http {
				read_timeout 0
				write_timeout 0
				dial_timeout 5s
			}
		}
	}

	# Admin panel → Go signaling
	handle /admin* {
		reverse_proxy signaling:8080 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			flush_interval -1
		}
	}

	# Health check (для uptime monitors и load balancers) → signaling
	handle /healthz {
		reverse_proxy signaling:8080
	}

	# ─── Static landing page ──────────────────────────────────────
	# Только / и /index.html — landing page из /srv.
	# Audit fix 2026-04-25 (#5): убрал try_files {path} /index.html — раньше
	# опечатка в API URL (например /apii/v1/session/create) ловилась этим
	# fallback'ом и возвращала 200 + HTML landing вместо 404. Это плохо для
	# debug + теоретически может ломать клиента который ждёт JSON.
	#
	# Теперь несуществующий путь = file_server's дефолтный 404 (Caddy сам
	# отдаст pretty error page или plain). Landing serve'ится только для
	# точно matched / и /index.html.
	handle {
		root * /srv
		file_server {
			# Не показывать directory listing — если кто-то запросит /foo/bar,
			# отдаём 404 вместо listing'а содержимого папки.
			hide .*
		}
	}

	# ─── Access log ───────────────────────────────────────────────
	log {
		output file /var/log/caddy/access.log {
			roll_size 10mb
			roll_keep 5
		}
		format json
	}
}
