<Window x:Class="ZConect.TestRunner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ZConect Live FT Test Runner" Height="700" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E" Foreground="#E0E0E0">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontFamily" Value="Consolas"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#0E639C"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="ZConect Live FileTransfer Test Runner" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>

        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="200"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Login:" VerticalAlignment="Center"/>
            <TextBox x:Name="LoginBox" Grid.Column="1" MaxLength="8" ToolTip="8-значный код с host (Create Session → login)"/>
            <TextBlock Grid.Column="3" Text="Pass:" VerticalAlignment="Center"/>
            <TextBox x:Name="PassBox" Grid.Column="4" MaxLength="8" ToolTip="8-значный код с host (Create Session → pass)"/>
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Host save dir:" VerticalAlignment="Center"/>
            <TextBox x:Name="SaveDirBox" Grid.Column="1" ToolTip="Папка на ноутбуке, куда ZConect сохраняет входящие файлы"/>
            <Button Grid.Column="2" Content="Browse..." Margin="6,0,0,0" Click="OnBrowseSaveDir"/>
        </Grid>

        <Grid Grid.Row="3" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Test:" VerticalAlignment="Center"/>
            <ComboBox x:Name="TestPicker" Grid.Column="1" SelectedIndex="0">
                <ComboBoxItem Tag="LiveFileTransferConflictTests" Content="(Все тесты в LiveFileTransferConflictTests)"/>
                <ComboBoxItem Tag="FT_full_cycle_upload_download_conflict_overwrite" Content="Full cycle (3 файла upload+download+conflict) — 43с"/>
                <ComboBoxItem Tag="FT_stress_many_small_files_both_directions" Content="Stress 20 small files — 22с"/>
                <ComboBoxItem Tag="FT_unicode_filenames_roundtrip" Content="Unicode names (кириллица/китайский/emoji) — 7с"/>
                <ComboBoxItem Tag="FT_cancel_mid_upload_leaves_no_zombie" Content="Cancel mid-upload 40MB — 25с"/>
                <ComboBoxItem Tag="FT_conflict_skip_action_preserves_original" Content="Conflict SKIP — 35с"/>
                <ComboBoxItem Tag="FT_conflict_rename_action_creates_second_copy" Content="Conflict RENAME — 35с"/>
                <ComboBoxItem Tag="FT_folder_structure_upload_preserves_subfolders" Content="Folder subfolders (sub/deeper/leaf) — 6с"/>
                <ComboBoxItem Tag="FT_path_traversal_blocked_on_sender" Content="Path traversal security — 10с"/>
                <ComboBoxItem Tag="FT_conflict_timeout_fallback_rename" Content="Conflict timeout (30с) fallback — 35с"/>
                <ComboBoxItem Tag="FT_batch_100_files_queue_holds" Content="Batch 100 files — 41с"/>
                <ComboBoxItem Tag="FT_large_file_60mb_upload_download_integrity" Content="Large 60MB (SKIPPED — VPN artifact) — ~10 мин"/>
                <ComboBoxItem Tag="FT_conflict_overwrite_all_no_query_on_subsequent" Content="Conflict OverwriteAll (SKIPPED — investigation)"/>
                <ComboBoxItem Tag="FT_file_request_missing_path_yields_error" Content="FileRequest missing (SKIPPED — investigation)"/>
            </ComboBox>
        </Grid>

        <Grid Grid.Row="4" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="RunButton" Grid.Column="0" Content="▶ Run Test" Click="OnRunClick" Padding="20,8"/>
            <TextBlock x:Name="StatusText" Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" Text="Ready" FontSize="14"/>
            <Button x:Name="StopButton" Grid.Column="2" Content="■ Stop" Click="OnStopClick" IsEnabled="False" Background="#A72" Padding="16,8"/>
        </Grid>

        <Border Grid.Row="5" Background="#2A2A2A" BorderBrush="#444" BorderThickness="1" Padding="8,6" Margin="0,0,0,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Log file:" VerticalAlignment="Center" Foreground="#B0B0B0"/>
                <TextBox x:Name="LogPathBox" Grid.Column="1" IsReadOnly="True" Background="Transparent" BorderThickness="0" Margin="8,0,0,0" Foreground="#7FCFFF"/>
                <Button Grid.Column="2" Content="📋 Copy" Click="OnCopyPath" Padding="10,4" FontSize="11" Margin="6,0,0,0" Background="#444"/>
                <Button Grid.Column="3" Content="📁 Folder" Click="OnOpenFolder" Padding="10,4" FontSize="11" Margin="6,0,0,0" Background="#444"/>
                <Button Grid.Column="4" Content="👁 Open" Click="OnOpenLog" Padding="10,4" FontSize="11" Margin="6,0,0,0" Background="#444"/>
            </Grid>
        </Border>

        <TextBox x:Name="OutputBox" Grid.Row="6" IsReadOnly="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 TextWrapping="NoWrap" FontSize="11" Background="#0D0D0D" Foreground="#D4D4D4" BorderBrush="#444"/>

        <StatusBar Grid.Row="7" Background="#007ACC" Foreground="White" Margin="0,8,0,0" Padding="8,3">
            <StatusBarItem>
                <TextBlock x:Name="StatusBarText" Text="Ready. Login+Pass → Browse/type save dir → choose test → Run." Foreground="White"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
