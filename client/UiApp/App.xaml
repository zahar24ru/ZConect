<Application x:Class="UiApp.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:UiApp.Converters"
             StartupUri="MainWindow.xaml"
             ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <ResourceDictionary>
      <local:EmptyToVisibilityConverter x:Key="EmptyToVisibilityConverter"/>
      <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
      <local:NameToAvatarBrushConverter x:Key="NameToAvatarBrushConverter"/>
      <ResourceDictionary.MergedDictionaries>
        <ui:ThemesDictionary Theme="Light" />
        <ui:ControlsDictionary />
        <ResourceDictionary Source="Themes/LightColors.xaml"/>
        <ResourceDictionary Source="Themes/AppStyles.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>
