<Window x:Class="UiApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:props="clr-namespace:UiApp.Properties"
        mc:Ignorable="d"
        Title="ZConnect"
        Icon="app.ico"
        Height="620"
        Width="580"
        MinWidth="560"
        MinHeight="480"
        MaxHeight="900"
        Background="{DynamicResource WindowBgBrush}"
        ResizeMode="CanResizeWithGrip">
    <Grid>
        <!-- Main content layer -->
        <Grid Margin="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- Row 0: Menu bar -->
                <RowDefinition Height="Auto"/>  <!-- Row 1: ZConnect banner -->
                <RowDefinition Height="Auto"/>  <!-- Row 2: Lockout warning banner (visible only when HasUnattendedLockout) -->
                <RowDefinition Height="*"/>     <!-- Row 3: Tab control — растягивается, чтобы нижний бар не отрывался от status -->
                <RowDefinition Height="Auto"/>  <!-- Row 4: Status bar -->
            </Grid.RowDefinitions>

            <!-- Menu bar -->
            <Border Grid.Row="0"
                CornerRadius="8"
                Background="{DynamicResource SurfaceBgBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                Padding="2"
                Margin="0,0,0,8"
                Effect="{DynamicResource CardShadow}">
                <DockPanel>
                    <Button x:Name="MenuButton"
                            DockPanel.Dock="Left"
                            Style="{DynamicResource IconButtonStyle}"
                            Width="Auto" Height="28"
                            MinWidth="72"
                            Padding="14,0"
                            Margin="2,0,0,0"
                            Click="MenuButton_Click">
                        <TextBlock Text="{x:Static props:Strings.MenuButton}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"/>
                        <Button.ContextMenu>
                            <ContextMenu x:Name="MenuPopup" Placement="Bottom">
                                <MenuItem Header="{x:Static props:Strings.MenuSettings}" Click="MenuSystem_Click">
                                    <MenuItem.Icon>
                                        <TextBlock Text="&#xE713;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{x:Static props:Strings.MenuClearRecent}"
                                          Click="MenuClearRecent_Click"
                                          IsEnabled="{Binding HasRecentContacts}">
                                    <MenuItem.Icon>
                                        <TextBlock Text="&#xE74D;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator/>
                                <MenuItem Header="{x:Static props:Strings.MenuExit}" Click="MenuExit_Click">
                                    <MenuItem.Icon>
                                        <TextBlock Text="&#xE7E8;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource DangerBrush}"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <!-- Help button "?" -->
                    <Button x:Name="HelpButton"
                            DockPanel.Dock="Left"
                            Style="{DynamicResource IconButtonStyle}"
                            Width="28" Height="28"
                            Margin="2,0,0,0"
                            ToolTip="{x:Static props:Strings.HelpTooltip}"
                            Click="HelpButton_Click">
                        <TextBlock Text="?"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <!-- Theme toggle button (sun/moon) -->
                    <Button x:Name="ThemeToggleButton"
                        DockPanel.Dock="Right"
                        Style="{DynamicResource IconButtonStyle}"
                        ToolTip="{x:Static props:Strings.ThemeToggleTooltip}"
                        Width="28" Height="28"
                        Margin="0,0,2,0"
                        Click="ThemeToggle_Click">
                        <TextBlock x:Name="ThemeIcon" Text="&#xE708;"
                               FontFamily="Segoe MDL2 Assets" FontSize="12"
                               Foreground="{DynamicResource PrimaryBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Border/>
                    <!-- spacer -->
                </DockPanel>
            </Border>

            <!-- Banner -->
            <Border Grid.Row="1"
                CornerRadius="14"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                Padding="12,10"
                Margin="0,0,0,8"
                Effect="{DynamicResource CardShadow}">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="{DynamicResource GradientStartColor}" Offset="0"/>
                        <GradientStop Color="{DynamicResource GradientEndColor}" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <DockPanel>
                    <TextBlock Text="ZConnect"
                           FontSize="19"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryBrush}"
                           DockPanel.Dock="Left"
                           VerticalAlignment="Center"/>
                    <!-- Update badge (pulsing) — visible когда IsUpdateAvailable=true.
                         Click → открывает DownloadUrl в default браузере. -->
                    <Button x:Name="UpdateBadge"
                            DockPanel.Dock="Right"
                            VerticalAlignment="Center"
                            Margin="8,0,0,0"
                            Padding="8,3"
                            Cursor="Hand"
                            BorderThickness="0"
                            Click="UpdateBadge_Click"
                            Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Button.ToolTip>
                            <ToolTip>
                                <StackPanel MaxWidth="340">
                                    <TextBlock FontWeight="SemiBold" FontSize="12">
                                        <Run Text="{x:Static props:Strings.Update_Tooltip_NewVersion}"/>
                                        <Run Text="{Binding LatestVersionText}"/>
                                        <Run Text="{x:Static props:Strings.Update_Tooltip_Available}"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding UpdateReleaseNotes}"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Opacity="0.85"
                                               Margin="0,4,0,0"/>
                                    <TextBlock Text="{x:Static props:Strings.Update_Tooltip_ClickToOpen}"
                                               FontSize="10"
                                               Opacity="0.6"
                                               Margin="0,6,0,0"/>
                                    <TextBlock Text="{Binding UpdateSha256Short}"
                                               FontSize="9"
                                               Opacity="0.5"
                                               FontFamily="Consolas"
                                               Margin="0,4,0,0"
                                               Visibility="{Binding HasUpdateSha256, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                </StackPanel>
                            </ToolTip>
                        </Button.ToolTip>
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="UpdateBg"
                                        CornerRadius="10"
                                        Background="#F59E0B"
                                        Padding="{TemplateBinding Padding}">
                                    <StackPanel Orientation="Horizontal">
                                        <!-- Pulsing dot -->
                                        <Ellipse Width="6" Height="6" Fill="White"
                                                 VerticalAlignment="Center" Margin="0,0,5,0">
                                            <Ellipse.Triggers>
                                                <EventTrigger RoutedEvent="Ellipse.Loaded">
                                                    <BeginStoryboard>
                                                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                             From="1.0" To="0.3"
                                                                             Duration="0:0:1.0"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </Ellipse.Triggers>
                                        </Ellipse>
                                        <TextBlock VerticalAlignment="Center"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="White">
                                            <Run Text="{x:Static props:Strings.Update_Badge_Label}"/>
                                            <Run Text="{Binding LatestVersionText}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="UpdateBg" Property="Background" Value="#D97706"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <TextBlock x:Name="BannerVersionText"
                           FontSize="10"
                           Opacity="0.55"
                           Foreground="{DynamicResource PlaceholderBrush}"
                           VerticalAlignment="Bottom"
                           Margin="0,0,0,2"
                           DockPanel.Dock="Right"
                           HorizontalAlignment="Right"/>
                </DockPanel>
            </Border>

            <!-- Lockout warning banner (Row 2) — видимо только при HasUnattendedLockout=true.
                 Красный фон + красный текст, чтобы пользователь точно заметил что пароль
                 unattended-доступа сейчас «под замком» (active tier / failed attempts).
                 Клик — открывает Настройки сразу на вкладку «Общие» где кнопка «Снять блокировку». -->
            <Border Grid.Row="2"
                x:Name="LockoutBanner"
                CornerRadius="10"
                Background="#33EF4444"
                BorderBrush="{DynamicResource DangerBrush}"
                BorderThickness="1"
                Padding="12,8"
                Margin="0,0,0,8"
                Cursor="Hand"
                MouseLeftButtonUp="LockoutBanner_Click"
                Visibility="{Binding HasUnattendedLockout, Converter={StaticResource BoolToVisibilityConverter}}">
                <DockPanel>
                    <TextBlock Text="→"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource DangerBrush}"
                               VerticalAlignment="Center"
                               DockPanel.Dock="Right"
                               Margin="8,0,0,0"
                               ToolTip="{x:Static props:Strings.LockoutBanner_OpenSettings_Tooltip}"/>
                    <TextBlock Text="{Binding UnattendedLockoutDescription}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource DangerBrush}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"/>
                </DockPanel>
            </Border>

            <!-- Tabs -->
            <Border Grid.Row="3"
                CornerRadius="14"
                Background="{DynamicResource SurfaceBgBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                Padding="14"
                MinHeight="320"
                Margin="0,0,0,8"
                Effect="{DynamicResource CardShadow}">
                <TabControl x:Name="MainTabs" SelectionChanged="TabControl_SelectionChanged">

                    <!-- Создать сессию -->
                    <TabItem Margin="2,0,0,0">
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="16" Height="16" Margin="0,0,6,0">
                                    <Path Data="M8,1 V7 H14 V9 H8 V15 H6 V9 H0 V7 H6 V1 Z"
                                      Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/>
                                </Viewbox>
                                <TextBlock Text="{x:Static props:Strings.TabCreateSession}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </TabItem.Header>
                        <Grid Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{x:Static props:Strings.LabelLogin}"
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                                <TextBlock Grid.Column="2" Text="{x:Static props:Strings.LabelPassword}"
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                            </Grid>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                     Height="36"
                                     FontSize="16"
                                     FontWeight="SemiBold"
                                     FontFamily="Consolas"
                                     Style="{DynamicResource ReadOnlyTextBoxStyle}"
                                     Text="{Binding LoginCode}"
                                     Cursor="Hand"
                                     ToolTip="{x:Static props:Strings.Tooltip_CopyLoginPassword}"
                                     PreviewMouseDown="SessionCode_PreviewMouseDown"/>
                                <TextBox Grid.Column="2"
                                     Height="36"
                                     FontSize="16"
                                     FontWeight="SemiBold"
                                     FontFamily="Consolas"
                                     Style="{DynamicResource ReadOnlyTextBoxStyle}"
                                     Text="{Binding PassCode}"
                                     Cursor="Hand"
                                     ToolTip="{x:Static props:Strings.Tooltip_CopyLoginPassword}"
                                     PreviewMouseDown="SessionCode_PreviewMouseDown"/>
                            </Grid>

                            <Grid Grid.Row="2" Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0"
                                    Height="36"
                                    Content="{x:Static props:Strings.CreateSessionButton}"
                                    Style="{DynamicResource PrimaryButtonStyle}"
                                    Command="{Binding CreateSessionCommand}"/>
                                <Button Grid.Column="2"
                                    Height="36"
                                    Content="{x:Static props:Strings.RefreshPasswordButton}"
                                    Style="{DynamicResource PrimaryButtonStyle}"
                                    Command="{Binding RefreshSessionCommand}"/>
                            </Grid>

                            <!-- Recent contacts row — collapses when HasRecentContacts=false.
                                 ItemsControl + UniformGrid(3 cols) bind'нут к RecentContacts
                                 (computed из Contacts по LastConnectedUtc, top-3 за 30 дней).
                                 Каждая карточка = Button с custom ControlTemplate и hover-стилем,
                                 command = ConnectToSpecificContactCommand с CommandParameter={Binding}. -->
                            <StackPanel Grid.Row="3" Margin="0,14,0,0">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasRecentContacts}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="{x:Static props:Strings.RecentConnected}"
                                               HorizontalAlignment="Left"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <Button Content="{x:Static props:Strings.ToAddressBookLink}"
                                            HorizontalAlignment="Right"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Foreground="{DynamicResource PrimaryBrush}"
                                            FontSize="11"
                                            Padding="4,0"
                                            Cursor="Hand"
                                            Click="RecentSeeAll_Click"/>
                                </Grid>

                                <ItemsControl ItemsSource="{Binding RecentContacts}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <!-- WrapPanel с фикс. ItemWidth: на узком окне переносит карточки,
                                                 на широком — показывает все 5 в ряд. Не обрезает на MinWidth=560. -->
                                            <WrapPanel ItemWidth="104" ItemHeight="120" Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <!-- DataContext = RecentItem (unified VM для saved Contact
                                                 и ad-hoc history). Vertical layout: аватар сверху
                                                 + имя под ним. Save-to-contacts icon в top-right
                                                 только для history items (!IsSaved).
                                                 Wrapping Grid чтобы отдельная overlay-кнопка save
                                                 не попадала в клик на основной Button. -->
                                            <Grid Margin="3,0">
                                                <!-- Card button — вся область clickable, connect к RecentItem -->
                                                <Button Padding="0"
                                                        BorderThickness="0"
                                                        Background="Transparent"
                                                        HorizontalContentAlignment="Stretch"
                                                        VerticalContentAlignment="Stretch"
                                                        Cursor="Hand"
                                                        Command="{Binding DataContext.ConnectRecentItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}">
                                                    <Button.ToolTip>
                                                        <ToolTip>
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                                                <TextBlock Text="{Binding LastConnectedDisplay}" FontSize="11" Opacity="0.7"/>
                                                            </StackPanel>
                                                        </ToolTip>
                                                    </Button.ToolTip>
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="bd"
                                                                    CornerRadius="10"
                                                                    Background="{DynamicResource SurfaceAltBgBrush}"
                                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                                    BorderThickness="1"
                                                                    Padding="8,10"
                                                                    MinHeight="96">
                                                                <Grid>
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="Auto"/>
                                                                        <RowDefinition Height="*"/>
                                                                        <RowDefinition Height="Auto"/>
                                                                    </Grid.RowDefinitions>
                                                                    <!-- Avatar (row 0): gradient color по hash имени для named,
                                                                         серый для ephemeral. Subtle drop shadow для depth.
                                                                         (Emoji поддержку откатил — WPF TextBlock не рендерит
                                                                         color fonts, получался monochrome outline.)
                                                                         Presence dot (🟢/🔴/⚪) в bottom-right, только для saved
                                                                         (ephemeral всегда Unknown — не polling'ится PresenceService). -->
                                                                    <Grid Grid.Row="0"
                                                                          Width="36" Height="36"
                                                                          HorizontalAlignment="Center">
                                                                        <Border Width="36" Height="36"
                                                                                CornerRadius="18">
                                                                            <Border.Effect>
                                                                                <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.22" Color="#1F2E3D"/>
                                                                            </Border.Effect>
                                                                            <Border.Style>
                                                                                <Style TargetType="Border">
                                                                                    <Setter Property="Background"
                                                                                            Value="{Binding DisplayName, Converter={StaticResource NameToAvatarBrushConverter}}"/>
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding IsSaved}" Value="False">
                                                                                            <Setter Property="Background" Value="{DynamicResource PlaceholderBrush}"/>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </Border.Style>
                                                                            <TextBlock Text="{Binding FirstLetter}"
                                                                                       Foreground="White"
                                                                                       FontSize="17"
                                                                                       FontWeight="SemiBold"
                                                                                       FontFamily="Segoe UI Variable, Segoe UI"
                                                                                       HorizontalAlignment="Center"
                                                                                       VerticalAlignment="Center"/>
                                                                        </Border>
                                                                        <!-- Presence dot: 10px в bottom-right угле аватарки.
                                                                             Visible только для saved contacts (ephemeral всегда Unknown). -->
                                                                        <Ellipse Width="10" Height="10"
                                                                                 HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                                                 Fill="{Binding PresenceBrush}"
                                                                                 Stroke="{DynamicResource SurfaceBgBrush}"
                                                                                 StrokeThickness="1.5"
                                                                                 ToolTip="{Binding PresenceTooltip}"
                                                                                 Visibility="{Binding IsSaved, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                                    </Grid>
                                                                    <!-- Name (row 1 — flex центрирует вертикально) -->
                                                                    <TextBlock Grid.Row="1"
                                                                               Text="{Binding DisplayName}"
                                                                               FontSize="11"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               HorizontalAlignment="Center"
                                                                               TextAlignment="Center"
                                                                               VerticalAlignment="Center"
                                                                               Margin="0,6,0,2"
                                                                               MaxWidth="78"/>
                                                                    <!-- Meta (row 2): 🔒 + время -->
                                                                    <StackPanel Grid.Row="2"
                                                                                Orientation="Horizontal"
                                                                                HorizontalAlignment="Center">
                                                                        <TextBlock Text="🔒"
                                                                                   FontSize="8"
                                                                                   Margin="0,0,3,0"
                                                                                   Opacity="0.6">
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding HasSavedPassword}" Value="True">
                                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>
                                                                        <TextBlock Text="{Binding LastConnectedDisplay}"
                                                                                   FontSize="9"
                                                                                   Foreground="{DynamicResource PlaceholderBrush}"
                                                                                   TextTrimming="CharacterEllipsis"
                                                                                   MaxWidth="80"/>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource SurfaceBgBrush}"/>
                                                                    <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                                                    <!-- Hover lift: subtle shadow создаёт depth, card «приподнимается».
                                                                         BlurRadius 14 + ShadowDepth 3 → soft diffused glow, не harsh. -->
                                                                    <Setter TargetName="bd" Property="Effect">
                                                                        <Setter.Value>
                                                                            <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.18" Color="#1F2E3D"/>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                </Trigger>
                                                                <Trigger Property="IsPressed" Value="True">
                                                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBgBrush}"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>

                                                <!-- Save-to-contacts icon overlay: в top-right, visible только
                                                     для history items (IsSaved=false). Клик — prompt name +
                                                     создать Contact + удалить из history.
                                                     Segoe MDL2 E8FA "ContactInfo". -->
                                                <Button HorizontalAlignment="Right"
                                                        VerticalAlignment="Top"
                                                        Margin="0,6,6,0"
                                                        Width="22" Height="22"
                                                        Padding="0"
                                                        BorderThickness="0"
                                                        Background="Transparent"
                                                        Cursor="Hand"
                                                        ToolTip="{x:Static props:Strings.Tooltip_SaveToAddressBook}"
                                                        Command="{Binding DataContext.SaveRecentAsContactCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSaved}" Value="False">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="sbd"
                                                                    CornerRadius="11"
                                                                    Background="{DynamicResource SurfaceBgBrush}"
                                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                                    BorderThickness="1"
                                                                    Opacity="0.85">
                                                                <TextBlock Text="&#xE710;"
                                                                           FontFamily="Segoe MDL2 Assets"
                                                                           FontSize="11"
                                                                           Foreground="{DynamicResource PrimaryBrush}"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="sbd" Property="Opacity" Value="1"/>
                                                                    <Setter TargetName="sbd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Grid>
                    </TabItem>

                    <!-- Подключиться -->
                    <TabItem Margin="0,0,0,0">
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="16" Height="16" Margin="0,0,6,0">
                                    <Path Data="M1,2 C0.4,2 0,2.5 0,3 V11 C0,11.5 0.4,12 1,12 H6 V14 H10 V12 H15 C15.6,12 16,11.5 16,11 V3 C16,2.5 15.6,2 15,2 Z M1.5,3.5 H14.5 V10.5 H1.5 Z"
                                      Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/>
                                </Viewbox>
                                <TextBlock Text="{x:Static props:Strings.TabJoin}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </TabItem.Header>
                        <Grid Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                   Text="{x:Static props:Strings.JoinIntro}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>

                            <Grid Grid.Row="1" Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0">
                                    <TextBox x:Name="JoinLoginBox"
                                         Height="36"
                                         FontSize="15"
                                         FontWeight="SemiBold"
                                         FontFamily="Consolas"
                                         MaxLength="8"
                                         Style="{DynamicResource DigitsOnlyTextBoxStyle}"
                                         Text="{Binding JoinLoginCode, UpdateSourceTrigger=PropertyChanged}"
                                         PreviewTextInput="DigitsOnly_PreviewTextInput"
                                         DataObject.Pasting="DigitsOnly_Pasting"/>
                                    <TextBlock Text="{x:Static props:Strings.Join_LoginPlaceholder}"
                                           IsHitTestVisible="False"
                                           VerticalAlignment="Center"
                                           Margin="12,0,0,0"
                                           Foreground="{DynamicResource PlaceholderBrush}"
                                           FontSize="13">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding JoinLoginCode, Converter={StaticResource EmptyToVisibilityConverter}}" Value="Visible"/>
                                                            <Condition Binding="{Binding ElementName=JoinLoginBox, Path=IsKeyboardFocusWithin}" Value="False"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                                <Grid Grid.Column="2">
                                    <TextBox x:Name="JoinPassBox"
                                         Height="36"
                                         FontSize="15"
                                         FontWeight="SemiBold"
                                         FontFamily="Consolas"
                                         MaxLength="8"
                                         Style="{DynamicResource DigitsOnlyTextBoxStyle}"
                                         Text="{Binding JoinPassCode, UpdateSourceTrigger=PropertyChanged}"
                                         PreviewTextInput="DigitsOnly_PreviewTextInput"
                                         DataObject.Pasting="DigitsOnly_Pasting"
                                         KeyDown="JoinPassBox_KeyDown"/>
                                    <TextBlock Text="{x:Static props:Strings.Join_PasswordPlaceholder}"
                                           IsHitTestVisible="False"
                                           VerticalAlignment="Center"
                                           Margin="12,0,0,0"
                                           Foreground="{DynamicResource PlaceholderBrush}"
                                           FontSize="13">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding JoinPassCode, Converter={StaticResource EmptyToVisibilityConverter}}" Value="Visible"/>
                                                            <Condition Binding="{Binding ElementName=JoinPassBox, Path=IsKeyboardFocusWithin}" Value="False"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Grid>

                            <Grid Grid.Row="2" Margin="0,10,0,0">
                                <Button Height="36"
                                        Content="{x:Static props:Strings.JoinButton}"
                                        Style="{DynamicResource PrimaryButtonStyle}"
                                        Command="{Binding JoinSessionCommand}">
                                    <Button.IsEnabled>
                                        <MultiBinding Converter="{StaticResource ValidJoinCodesConverter}">
                                            <Binding Path="JoinLoginCode"/>
                                            <Binding Path="JoinPassCode"/>
                                        </MultiBinding>
                                    </Button.IsEnabled>
                                </Button>
                                <!-- Indeterminate progress bar at bottom of button while VIEWER is joining.
                                     NOT IsConnecting — host после Create Session остаётся в state=Connecting
                                     пока viewer не придёт, и без IsJoiningAsViewer кнопка "Подключиться"
                                     в этой вкладке анимировалась бы бесконечно у host'а. -->
                                <ProgressBar Height="3"
                                             VerticalAlignment="Bottom"
                                             Margin="12,0,12,0"
                                             IsIndeterminate="True"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Foreground="White"
                                             Visibility="{Binding IsJoiningAsViewer, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </Grid>

                            <!-- 4-step progress indicator: Signaling → ICE → Stream → Ready.
                                 Видим только пока ConnectionStep 1..3 и IsJoiningAsViewer.
                                 На step 4 (Ready) автоматически исчезает. -->
                            <Border Grid.Row="3" Margin="0,12,0,0"
                                    Padding="10,8"
                                    CornerRadius="8"
                                    Background="{DynamicResource SurfaceAltBgBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    Visibility="{Binding ConnectionStepVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Step 1: Signaling (API + WS) -->
                                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                        <Ellipse Width="10" Height="10" HorizontalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{DynamicResource BorderBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Step1Filled}" Value="True">
                                                            <Setter Property="Fill" Value="{DynamicResource PrimaryBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="Signaling" FontSize="10"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <!-- Step 2: ICE -->
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                        <Ellipse Width="10" Height="10" HorizontalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{DynamicResource BorderBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Step2Filled}" Value="True">
                                                            <Setter Property="Fill" Value="{DynamicResource PrimaryBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="ICE" FontSize="10"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <!-- Step 3: DataChannel / Stream -->
                                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                        <Ellipse Width="10" Height="10" HorizontalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{DynamicResource BorderBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Step3Filled}" Value="True">
                                                            <Setter Property="Fill" Value="{DynamicResource PrimaryBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="Stream" FontSize="10"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <!-- Step 4: Ready -->
                                    <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                                        <Ellipse Width="10" Height="10" HorizontalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{DynamicResource BorderBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Step4Filled}" Value="True">
                                                            <Setter Property="Fill" Value="{DynamicResource PrimaryBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="Ready" FontSize="10"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- File transfer and remote desktop buttons removed — available after connection -->
                        </Grid>
                    </TabItem>

                    <!-- Адресная книга -->
                    <TabItem Margin="0,0,2,0">
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="16" Height="16" Margin="0,0,6,0">
                                    <Path Data="M5.5,1 C3.6,1 2,2.6 2,4.5 C2,6.4 3.6,8 5.5,8 C7.4,8 9,6.4 9,4.5 C9,2.6 7.4,1 5.5,1 Z M0,15 C0,12 2.5,10 5.5,10 C8.5,10 11,12 11,15 Z M12,4.5 C12,3 13,1.5 14.5,1.5 C16,1.5 17,3 17,4.5 C17,6 16,7.5 14.5,7.5 C13,7.5 12,6 12,4.5 Z M12,10 C12,10 13,9.5 14.5,9.5 C16.5,9.5 18,11 18,13.5 H12"
                                      Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/>
                                </Viewbox>
                                <TextBlock Text="{x:Static props:Strings.TabAddressBook}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </TabItem.Header>
                        <Grid Margin="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{x:Static props:Strings.AddressBook_Contacts}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,6"/>

                                <Grid>
                                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6"
                                        Margin="0,0,0,8" MinHeight="140" MaxHeight="320">
                                        <ListBox x:Name="ContactsListBox"
                                         ItemsSource="{Binding Contacts}"
                                         SelectedItem="{Binding SelectedContact}"
                                         SelectionChanged="ContactsListBox_SelectionChanged"
                                         BorderThickness="0"
                                         Padding="2"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                    <Setter Property="Padding" Value="6,3"/>
                                                    <Setter Property="Margin" Value="2,0"/>
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ListBoxItem">
                                                                <Border x:Name="Bd"
                                                                        Background="{TemplateBinding Background}"
                                                                        CornerRadius="6"
                                                                        Padding="{TemplateBinding Padding}"
                                                                        Margin="{TemplateBinding Margin}">
                                                                    <ContentPresenter HorizontalAlignment="Stretch"
                                                                                      VerticalAlignment="Center"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="Bd" Property="Background">
                                                                            <Setter.Value>
                                                                                <SolidColorBrush Color="{DynamicResource HoverBgColor}"/>
                                                                            </Setter.Value>
                                                                        </Setter>
                                                                    </Trigger>
                                                                    <Trigger Property="IsSelected" Value="True">
                                                                        <Setter TargetName="Bd" Property="Background">
                                                                            <Setter.Value>
                                                                                <SolidColorBrush Color="{DynamicResource SelectedBgColor}"/>
                                                                            </Setter.Value>
                                                                        </Setter>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <!-- Avatar: colored circle with first letter of name + presence dot -->
                                                        <Grid Grid.Column="0" Width="26" Height="26" Margin="0,0,8,0"
                                                              VerticalAlignment="Center">
                                                            <Ellipse Width="24" Height="24"
                                                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                     Fill="{Binding Name, Converter={StaticResource NameToColorConverter}}"/>
                                                            <TextBlock Text="{Binding Name, Converter={StaticResource NameToInitialConverter}}"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="White"
                                                                       FontWeight="SemiBold"
                                                                       FontSize="11"/>
                                                            <!-- Presence dot: bottom-right corner -->
                                                            <Ellipse Width="8" Height="8"
                                                                     HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                                     Fill="{Binding PresenceBrush}"
                                                                     Stroke="{DynamicResource SurfaceBgBrush}"
                                                                     StrokeThickness="1.5"
                                                                     ToolTip="{Binding PresenceTooltip}"/>
                                                        </Grid>
                                                        <TextBlock Grid.Column="1"
                                                           Text="{Binding Name}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"/>
                                                        <Button Grid.Column="2"
                                                        Style="{DynamicResource IconButtonStyle}"
                                                        ToolTip="{x:Static props:Strings.AddressBook_Edit_Tooltip}"
                                                        Command="{Binding DataContext.EditContactCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                        CommandParameter="{Binding}">
                                                            <TextBlock Text="&#xE104;" FontFamily="Segoe MDL2 Assets"
                                                               FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                        </Button>
                                                        <Button Grid.Column="3"
                                                        Style="{DynamicResource IconButtonStyle}"
                                                        ToolTip="{x:Static props:Strings.Button_Delete}"
                                                        Command="{Binding DataContext.RemoveContactCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                        CommandParameter="{Binding}">
                                                            <TextBlock Text="&#xE107;" FontFamily="Segoe MDL2 Assets"
                                                               FontSize="12" Foreground="{DynamicResource DangerBrush}"/>
                                                        </Button>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Border>

                                    <!-- Empty state overlay: icon + text -->
                                    <StackPanel HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                IsHitTestVisible="False">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Contacts.Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <Viewbox Width="42" Height="42" Margin="0,0,0,10" Opacity="0.65">
                                            <Path Data="M5.5,1 C3.6,1 2,2.6 2,4.5 C2,6.4 3.6,8 5.5,8 C7.4,8 9,6.4 9,4.5 C9,2.6 7.4,1 5.5,1 Z M0,15 C0,12 2.5,10 5.5,10 C8.5,10 11,12 11,15 Z M12,4.5 C12,3 13,1.5 14.5,1.5 C16,1.5 17,3 17,4.5 C17,6 16,7.5 14.5,7.5 C13,7.5 12,6 12,4.5 Z M12,10 C12,10 13,9.5 14.5,9.5 C16.5,9.5 18,11 18,13.5 H12"
                                                  Fill="{DynamicResource PlaceholderBrush}"/>
                                        </Viewbox>
                                        <TextBlock Text="{x:Static props:Strings.EmptyContacts}"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="13"
                                               FontWeight="Medium"/>
                                        <TextBlock Text="{x:Static props:Strings.EmptyContactsHint}"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource PlaceholderBrush}"
                                               FontSize="11"
                                               Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>

                                <Button Content="{x:Static props:Strings.Button_Connect}"
                                    Style="{DynamicResource PrimaryButtonStyle}"
                                    Command="{Binding ConnectToContactCommand}"
                                    Height="36"/>
                            </StackPanel>

                            <Border Grid.Column="2"
                                CornerRadius="8"
                                Background="{DynamicResource SurfaceAltBgBrush}"
                                BorderBrush="{DynamicResource SurfaceAltBorderBrush}"
                                BorderThickness="1"
                                Padding="10">
                                <StackPanel>
                                    <TextBlock Text="{Binding ContactFormTitle}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           Margin="0,0,0,8"/>
                                    <TextBlock Text="{x:Static props:Strings.LabelName}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="12"
                                           Margin="0,0,0,2"/>
                                    <Grid Margin="0,0,0,6">
                                        <TextBox Height="28"
                                             MaxLength="64"
                                             Text="{Binding NewContactName, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Text="{x:Static props:Strings.AddressBook_ContactName_Placeholder}"
                                               IsHitTestVisible="False"
                                               VerticalAlignment="Center"
                                               Margin="6,0,0,0"
                                               Foreground="{DynamicResource PlaceholderBrush}"
                                               FontSize="12"
                                               Visibility="{Binding NewContactName, Converter={StaticResource EmptyToVisibilityConverter}}" HorizontalAlignment="Left" Width="176"/>
                                    </Grid>
                                    <TextBlock Text="{x:Static props:Strings.LabelCodes}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="12"
                                           Margin="0,0,0,2"/>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid Grid.Column="0">
                                            <TextBox Height="28"
                                                 Text="{Binding NewContactLogin, UpdateSourceTrigger=PropertyChanged}"/>
                                            <TextBlock Text="12345678"
                                                   IsHitTestVisible="False"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource PlaceholderBrush}"
                                                   FontSize="12"
                                                   Visibility="{Binding NewContactLogin, Converter={StaticResource EmptyToVisibilityConverter}}" HorizontalAlignment="Center" Width="78"/>
                                        </Grid>
                                        <Grid Grid.Column="2">
                                            <TextBox Height="28"
                                                 Text="{Binding NewContactPass, UpdateSourceTrigger=PropertyChanged}"/>
                                            <TextBlock Text="87654321"
                                                   IsHitTestVisible="False"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource PlaceholderBrush}"
                                                   FontSize="12"
                                                   Visibility="{Binding NewContactPass, Converter={StaticResource EmptyToVisibilityConverter}}" HorizontalAlignment="Center" Width="78"/>
                                        </Grid>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0"
                                            Content="{Binding ContactFormButtonText}"
                                            Style="{DynamicResource PrimaryButtonStyle}"
                                            Command="{Binding AddContactCommand}"
                                            Padding="8,8"
                                            Height="36"/>
                                        <Button Grid.Column="2"
                                            Content="{x:Static props:Strings.Button_Cancel}"
                                            Style="{DynamicResource SecondaryButtonStyle}"
                                            Command="{Binding CancelEditContactCommand}"
                                            Padding="8,8"
                                            Height="36"
                                            Visibility="{Binding IsEditingContact, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>

            <!-- Status bar -->
            <Border Grid.Row="4"
                CornerRadius="14"
                Background="{DynamicResource SurfaceBgBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                Padding="12"
                Effect="{DynamicResource CardShadow}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Ellipse Grid.Column="0"
                             Width="10" Height="10"
                             VerticalAlignment="Center"
                             Margin="0,0,8,0"
                             Fill="{Binding StatusDotBrush}">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{Binding StatusDotBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnecting}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard Name="PulseStoryboard">
                                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     From="1.0" To="0.15"
                                                                     Duration="0:0:0.7"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <StopStoryboard BeginStoryboardName="PulseStoryboard"/>
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <Grid Grid.Column="1" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Text="{Binding StatusText, Mode=OneWay}"
                                       TextTrimming="CharacterEllipsis"
                                       TextWrapping="NoWrap"
                                       VerticalAlignment="Center"/>
                            <!-- 3 animated dots — visible only while connecting. Grid.Column=1 Auto -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="6,0,0,0" VerticalAlignment="Center"
                                        Visibility="{Binding IsConnecting, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Ellipse Width="4" Height="4" Margin="1,0,1,0" Fill="{DynamicResource TextSecondaryBrush}">
                                    <Ellipse.Triggers>
                                        <EventTrigger RoutedEvent="Ellipse.Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     From="0.2" To="1" Duration="0:0:0.4"
                                                                     AutoReverse="True"
                                                                     BeginTime="0:0:0"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Ellipse.Triggers>
                                </Ellipse>
                                <Ellipse Width="4" Height="4" Margin="1,0,1,0" Fill="{DynamicResource TextSecondaryBrush}">
                                    <Ellipse.Triggers>
                                        <EventTrigger RoutedEvent="Ellipse.Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     From="0.2" To="1" Duration="0:0:0.4"
                                                                     AutoReverse="True"
                                                                     BeginTime="0:0:0.15"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Ellipse.Triggers>
                                </Ellipse>
                                <Ellipse Width="4" Height="4" Margin="1,0,1,0" Fill="{DynamicResource TextSecondaryBrush}">
                                    <Ellipse.Triggers>
                                        <EventTrigger RoutedEvent="Ellipse.Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     From="0.2" To="1" Duration="0:0:0.4"
                                                                     AutoReverse="True"
                                                                     BeginTime="0:0:0.3"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Ellipse.Triggers>
                                </Ellipse>
                            </StackPanel>
                        </Grid>
                        <!-- Session countdown (subtle pill) -->
                        <Border Grid.Column="2"
                            CornerRadius="4"
                            Background="Transparent"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            Padding="6,2"
                            VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SessionCountdownText}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding SessionCountdownText, Mode=OneWay}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="12"
                                   FontWeight="Medium"
                                   FontFamily="Consolas"/>
                        </Border>
                    </Grid>
                    <TextBlock Text="{Binding ViewerConnectionStatus}"
                           FontSize="12"
                           Foreground="{Binding ViewerConnectionStatusBrush}"
                           FontWeight="SemiBold"
                           Margin="0,4,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ViewerConnectionStatus}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding HostStatsText}"
                           FontSize="11"
                           FontFamily="Consolas"
                           Foreground="{DynamicResource HostStatsBrush}"
                           Margin="0,4,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HostStatsText}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Scrim overlay: dims the main window while a modal dialog is open. -->
        <Border x:Name="Scrim"
                Background="#000000"
                Opacity="0"
                IsHitTestVisible="False"
                Panel.ZIndex="500"/>

        <!-- Toast overlay (bottom-center snackbar, slides up) -->
        <Border x:Name="ToastOverlay"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,60"
                RenderTransformOrigin="0.5,0.5"
                CornerRadius="10"
                Padding="18,10"
                IsHitTestVisible="False"
                Opacity="0">
            <Border.Background>
                <SolidColorBrush Color="#1A1A2E" Opacity="0.92"/>
            </Border.Background>
            <Border.RenderTransform>
                <TranslateTransform x:Name="ToastTransform" Y="30"/>
            </Border.RenderTransform>
            <TextBlock x:Name="ToastText"
                       Text=""
                       Foreground="White"
                       FontSize="14"
                       FontWeight="SemiBold"/>
        </Border>

        <!-- Viewer connected toast (top-right corner) -->
        <Border x:Name="ViewerToast"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                CornerRadius="10"
                Padding="14,10"
                Margin="0,20,20,0"
                IsHitTestVisible="False"
                Opacity="0">
            <Border.Background>
                <SolidColorBrush Color="#155FA2" Opacity="0.92"/>
            </Border.Background>
            <TextBlock Text="{x:Static props:Strings.Toast_ViewerConnected}"
                       Foreground="White"
                       FontSize="13"
                       FontWeight="SemiBold"/>
        </Border>

        <!-- Onboarding overlay — показывается при первом запуске пока
             OnboardingCompleted=false в settings. 3-step wizard с Далее/Готово. -->
        <Grid x:Name="OnboardingOverlay"
              Panel.ZIndex="1000"
              Visibility="Collapsed">
            <!-- Dim backdrop -->
            <Rectangle>
                <Rectangle.Fill>
                    <SolidColorBrush Color="Black" Opacity="0.65"/>
                </Rectangle.Fill>
            </Rectangle>
            <!-- Wizard card -->
            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource SurfaceBgBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="26,22"
                    MaxWidth="380"
                    Effect="{DynamicResource CardShadow}">
                <StackPanel>
                    <!-- Step icon -->
                    <Viewbox Width="56" Height="56" Margin="0,0,0,12" HorizontalAlignment="Center">
                        <Path x:Name="OnboardingStepIcon"
                              Fill="{DynamicResource PrimaryBrush}"
                              Data="M8,1 V7 H14 V9 H8 V15 H6 V9 H0 V7 H6 V1 Z"/>
                    </Viewbox>
                    <!-- Step title -->
                    <TextBlock x:Name="OnboardingStepTitle"
                               Text="{x:Static props:Strings.Onboarding_Welcome_Title}"
                               HorizontalAlignment="Center"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,0,0,8"/>
                    <!-- Step text -->
                    <TextBlock x:Name="OnboardingStepText"
                               Text="{x:Static props:Strings.Onboarding_Welcome_Text}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               FontSize="13"
                               LineHeight="19"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,0,0,18"/>
                    <!-- Privacy step extras (visible only on privacy step) -->
                    <StackPanel x:Name="OnboardingPrivacyPanel"
                                Visibility="Collapsed"
                                Margin="0,0,0,14">
                        <TextBlock HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   FontSize="12"
                                   Margin="0,0,0,10">
                            <Hyperlink NavigateUri="https://zconn.ru/privacy_win.html"
                                       RequestNavigate="Onboarding_Hyperlink_RequestNavigate">
                                <Run Text="{x:Static props:Strings.Onboarding_Privacy_Open_Link}"/>
                            </Hyperlink>
                        </TextBlock>
                        <CheckBox x:Name="OnboardingPrivacyCheckbox"
                                  HorizontalAlignment="Center"
                                  FontSize="12"
                                  Foreground="{DynamicResource TextSecondaryBrush}"
                                  Content="{x:Static props:Strings.Onboarding_Privacy_Ack}"/>
                    </StackPanel>
                    <!-- Progress dots -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,18">
                        <Ellipse x:Name="OnboardingDot1" Width="8" Height="8" Margin="3,0"
                                 Fill="{DynamicResource PrimaryBrush}"/>
                        <Ellipse x:Name="OnboardingDot2" Width="8" Height="8" Margin="3,0"
                                 Fill="{DynamicResource BorderBrush}"/>
                        <Ellipse x:Name="OnboardingDot3" Width="8" Height="8" Margin="3,0"
                                 Fill="{DynamicResource BorderBrush}"/>
                        <Ellipse x:Name="OnboardingDot4" Width="8" Height="8" Margin="3,0"
                                 Fill="{DynamicResource BorderBrush}"/>
                    </StackPanel>
                    <!-- Action buttons -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="OnboardingSkipButton"
                                Grid.Column="0"
                                Content="{x:Static props:Strings.Button_Skip}"
                                Style="{DynamicResource SecondaryButtonStyle}"
                                MinWidth="110"
                                Height="38"
                                Padding="14,0"
                                Click="OnboardingSkip_Click"/>
                        <Button x:Name="OnboardingNextButton"
                                Grid.Column="2"
                                Content="{x:Static props:Strings.Button_Next}"
                                Style="{DynamicResource PrimaryButtonStyle}"
                                MinWidth="130"
                                Height="38"
                                Padding="16,0"
                                Click="OnboardingNext_Click"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
