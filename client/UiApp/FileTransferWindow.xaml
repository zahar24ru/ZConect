<Window x:Class="UiApp.FileTransferWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:props="clr-namespace:UiApp.Properties"
        Title="{x:Static props:Strings.FileTransfer_Title}"
        MinWidth="880"
        MinHeight="560"
        Width="1040"
        Height="640"
        WindowStartupLocation="Manual"
        Background="{DynamicResource WindowBgBrush}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <!-- Colors come from global theme (LightColors.xaml / DarkColors.xaml). -->

        <!-- ContextMenu (WinUI-inspired) -->
        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource SurfaceBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="HasDropShadow" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.12" Color="#000000"/>
                            </Border.Effect>
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- MenuItem (WinUI-inspired) -->
        <Style TargetType="MenuItem">
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter x:Name="Icon" Grid.Column="0" ContentSource="Icon"
                                                  Width="16" Height="16" VerticalAlignment="Center"/>
                                <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center" Margin="4,0,0,0"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="{DynamicResource HoverBgColor}"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Separator in menus -->
        <Style TargetType="Separator">
            <Setter Property="Margin" Value="8,4"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SeparatorBrush}"/>
            <Setter Property="BorderThickness" Value="0,1,0,0"/>
        </Style>

        <!-- Toolbar SVG icons (16x16 viewbox) -->
        <Geometry x:Key="IconHome">M8 1 L1 7 L3 7 L3 14 L6.5 14 L6.5 10 L9.5 10 L9.5 14 L13 14 L13 7 L15 7 Z</Geometry>
        <Geometry x:Key="IconUp">M8 2 L2 10 L5.5 10 L5.5 14 L10.5 14 L10.5 10 L14 10 Z</Geometry>
        <Geometry x:Key="IconRefresh">M13.5 8 A5.5 5.5 0 1 1 8 2.5 L8 0 L12 3.5 L8 7 L8 4.5 A3.5 3.5 0 1 0 11.5 8 Z</Geometry>
        <Geometry x:Key="IconNewFolder">M1 3 C0.4 3 0 3.4 0 4 V13 C0 13.6 0.4 14 1 14 H15 C15.6 14 16 13.6 16 13 V6 C16 5.4 15.6 5 15 5 H8.5 L7 3 Z M10 8 L10 10 L8 10 L8 11 L10 11 L10 13 L11 13 L11 11 L13 11 L13 10 L11 10 L11 8 Z</Geometry>
        <Geometry x:Key="IconDelete">M5.5 1 L5 2 L2 2 L2 3 L14 3 L14 2 L11 2 L10.5 1 Z M3 4 L3 14 C3 14.6 3.4 15 4 15 L12 15 C12.6 15 13 14.6 13 14 L13 4 Z M6 6 L6 13 L7 13 L7 6 Z M9 6 L9 13 L10 13 L10 6 Z</Geometry>
        <Geometry x:Key="IconProperties">M1 2 L1 3 L15 3 L15 2 Z M1 5 L1 6 L10 6 L10 5 Z M1 8 L1 9 L12 9 L12 8 Z M1 11 L1 12 L8 12 L8 11 Z M1 14 L1 15 L11 15 L11 14 Z</Geometry>
        <Geometry x:Key="IconRename">M2 3 L2 13 L10 13 L10 12 L3 12 L3 4 L10 4 L10 3 Z M6 7 L6 9 L14 9 L14 7 Z</Geometry>
        <Geometry x:Key="IconCopyPath">M4 1 C3.4 1 3 1.4 3 2 L3 12 L4 12 L4 2 L11 2 L11 1 Z M6 3 C5.4 3 5 3.4 5 4 L5 14 C5 14.6 5.4 15 6 15 L12 15 C12.6 15 13 14.6 13 14 L13 4 C13 3.4 12.6 3 12 3 Z M6 4 L12 4 L12 14 L6 14 Z</Geometry>

        <!-- Sort ComboBox item template -->
        <DataTemplate x:Key="SortItemTemplate">
            <TextBlock Text="{Binding Label}" FontSize="12" VerticalAlignment="Center"/>
        </DataTemplate>

        <!-- ComboBox/ComboBoxItem — styled by Wpf.Ui ControlsDictionary.
             Just keep the SortItemTemplate for data binding. -->

        <!-- Toolbar button style (WinUI-inspired) -->
        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}"
                                BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="{DynamicResource HoverBgColor}"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="{DynamicResource BorderColor}"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Transfer action button (arrow) -->
        <Style x:Key="TransferArrowButton" TargetType="Button">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{DynamicResource PrimaryBrush}"
                                CornerRadius="8" Padding="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="{DynamicResource PrimaryHoverColor}"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="{DynamicResource PrimaryHoverColor}"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="{DynamicResource BorderColor}"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Card style -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>

        <!-- ListBox item hover style -->
        <Style x:Key="FileListBox" TargetType="ListBox">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="8,5,8,5"/>
                        <Setter Property="Margin" Value="2,0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="6"
                                            Padding="{TemplateBinding Padding}" Margin="{TemplateBinding Margin}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background">
                                                <Setter.Value>
                                                    <SolidColorBrush Color="{DynamicResource HoverBgColor}"/>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background">
                                                <Setter.Value>
                                                    <SolidColorBrush Color="{DynamicResource HoverBgColor}"/>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Breadcrumb label style -->
        <Style x:Key="BreadcrumbLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="TextDecorations" Value="Underline"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- File item template -->
        <!-- View: Details (table) — default -->
        <DataTemplate x:Key="FileItemDetailsTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="22"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="70"/>
                </Grid.ColumnDefinitions>
                <Viewbox Grid.Column="0" Width="16" Height="16" VerticalAlignment="Center">
                    <Path Data="{Binding IconGeometry}" Fill="{Binding IconColor}"/>
                </Viewbox>
                <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Margin="4,0,8,0" FontSize="13">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Grid.Column="2" Text="{Binding DateText}" FontSize="10"
                           Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="3" Text="{Binding SizeText}" FontSize="11"
                           FontFamily="Consolas" TextAlignment="Right"
                           Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>

        <!-- View: Small icons -->
        <DataTemplate x:Key="FileItemSmallTemplate">
            <StackPanel Orientation="Horizontal" Margin="0,1">
                <Viewbox Width="16" Height="16" Margin="0,0,4,0">
                    <Path Data="{Binding IconGeometry}" Fill="{Binding IconColor}"/>
                </Viewbox>
                <TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" MaxWidth="200">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </DataTemplate>

        <!-- View: Large icons -->
        <DataTemplate x:Key="FileItemLargeTemplate">
            <StackPanel Width="90" Margin="4,4" HorizontalAlignment="Center">
                <Viewbox Width="40" Height="40" Margin="0,0,0,4" HorizontalAlignment="Center">
                    <Path Data="{Binding IconGeometry}" Fill="{Binding IconColor}"/>
                </Viewbox>
                <TextBlock Text="{Binding Name}" FontSize="11" TextAlignment="Center"
                           TextTrimming="CharacterEllipsis" TextWrapping="Wrap" MaxHeight="32"
                           HorizontalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding SizeText}" FontSize="9" TextAlignment="Center"
                           Foreground="{DynamicResource TextTertiaryBrush}"/>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="14,10,14,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Two-panel file browser -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left panel (local) -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,6,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Panel header -->
                    <Border Grid.Row="0" Background="{DynamicResource SurfaceAltBgBrush}" CornerRadius="10,10,0,0" Padding="12,8">
                        <TextBlock Text="{x:Static props:Strings.FileTransfer_LocalPanel}" FontWeight="SemiBold" FontSize="13"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </Border>

                    <!-- Toolbar -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="8,6,8,2">
                        <Button Style="{StaticResource ToolbarButton}" Command="{Binding HomeLeftCommand}" ToolTip="{x:Static props:Strings.FileTransfer_Tooltip_Home}" MinWidth="32">
                            <Viewbox Width="14" Height="14"><Path Data="{StaticResource IconHome}" Fill="{DynamicResource TextSecondaryBrush}"/></Viewbox>
                        </Button>
                        <Button Style="{StaticResource ToolbarButton}" Command="{Binding ParentLeftCommand}" ToolTip="{x:Static props:Strings.FileTransfer_Tooltip_Up}" MinWidth="32">
                            <Viewbox Width="14" Height="14"><Path Data="{StaticResource IconUp}" Fill="{DynamicResource TextSecondaryBrush}"/></Viewbox>
                        </Button>
                        <Button Style="{StaticResource ToolbarButton}" Command="{Binding RefreshLeftCommand}" ToolTip="{x:Static props:Strings.FileTransfer_Tooltip_Refresh}" MinWidth="32">
                            <Viewbox Width="14" Height="14"><Path Data="{StaticResource IconRefresh}" Fill="{DynamicResource TextSecondaryBrush}"/></Viewbox>
                        </Button>
                        <Rectangle Width="1" Fill="{DynamicResource BorderBrush}" Margin="4,4"/>
                        <Button Style="{StaticResource ToolbarButton}" Command="{Binding CreateFolderLeftCommand}" ToolTip="{x:Static props:Strings.FileTransfer_NewFolder}">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="14" Height="14" Margin="0,0,4,0"><Path Data="{StaticResource IconNewFolder}" Fill="#F0A030"/></Viewbox>
                                <TextBlock Text="{x:Static props:Strings.FileTransfer_Button_Folder}" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Button>
                        <ComboBox Width="120" MinHeight="30" FontSize="12" Margin="4,0,0,0" VerticalContentAlignment="Center"
                                  ItemsSource="{Binding SortOptions}"
                                  SelectedItem="{Binding LeftSortOption}" ToolTip="{x:Static props:Strings.FileTransfer_Tooltip_Sort}"
                                  ItemTemplate="{StaticResource SortItemTemplate}"/>
                        <Rectangle Width="1" Fill="{DynamicResource BorderBrush}" Margin="4,4"/>
                        <Button Style="{StaticResource ToolbarButton}" MinWidth="24" ToolTip="{x:Static props:Strings.FileTransfer_View_Details}"
                                Click="ViewMode_Details"><TextBlock Text="&#x2630;" FontSize="13"/></Button>
                        <Button Style="{StaticResource ToolbarButton}" MinWidth="24" ToolTip="{x:Static props:Strings.FileTransfer_View_Small}"
                                Click="ViewMode_Small"><TextBlock Text="&#x2637;" FontSize="13"/></Button>
                        <Button Style="{StaticResource ToolbarButton}" MinWidth="24" ToolTip="{x:Static props:Strings.FileTransfer_View_Large}"
                                Click="ViewMode_Large"><TextBlock Text="&#x2B1A;" FontSize="13"/></Button>
                    </StackPanel>

                    <!-- Breadcrumb -->
                    <Border Grid.Row="2" Margin="8,4,8,6" Background="{DynamicResource SurfaceAltBgBrush}"
                            BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="6,4" MinHeight="28">
                        <ItemsControl ItemsSource="{Binding LeftBreadcrumbs}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Label}"
                                                   MouseDown="LeftBreadcrumb_Click" Tag="{Binding FullPath}"
                                                   ToolTip="{Binding FullPath}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource BreadcrumbLabel}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsLast}" Value="True">
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text=" &#x203A; " Foreground="{DynamicResource TextTertiaryBrush}" FontSize="12" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsLast}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <!-- File list -->
                    <ListBox x:Name="LeftList" Grid.Row="3" Margin="4,0,4,6"
                             Style="{StaticResource FileListBox}"
                             ItemsSource="{Binding LeftItems}"
                             SelectionMode="Extended" SelectionChanged="LeftList_OnSelectionChanged"
                             MouseDoubleClick="LeftList_OnMouseDoubleClick"
                             KeyDown="LeftList_OnKeyDown" MouseMove="LeftList_OnMouseMove"
                             PreviewMouseDown="LeftList_OnPreviewMouseDown"
                             AllowDrop="True" Drop="LeftList_OnDrop" DragOver="List_OnDragOver"
                             ItemTemplate="{StaticResource FileItemDetailsTemplate}">
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{x:Static props:Strings.FileTransfer_ContextMenu_Properties}" Command="{Binding ShowPropertiesLeftCommand}">
                                    <MenuItem.Icon>
                                        <Viewbox Width="14" Height="14"><Path Data="{StaticResource IconProperties}" Fill="{DynamicResource TextSecondaryBrush}"/></Viewbox>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{x:Static props:Strings.FileTransfer_ContextMenu_Rename}" Command="{Binding RenameLeftCommand}">
                                    <MenuItem.Icon><Viewbox Width="14" Height="14"><Path Data="{StaticResource IconRename}" Fill="{DynamicResource TextSecondaryBrush}"/></Viewbox></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{x:Static props:Strings.FileTransfer_ContextMenu_CopyPath}" Command="{Binding CopyPathLeftCommand}">
                                    <MenuItem.Icon><Viewbox Width="14" Height="14"><Path Data="{StaticResource IconCopyPath}" Fill="{DynamicResource TextSecondaryBrush}"/></Viewbox></MenuItem.Icon>
                                </MenuItem>
                                <Separator/>
                                <MenuItem Header="{x:Static props:Strings.FileTransfer_ContextMenu_Delete}" Command="{Binding DeleteLeftCommand}">
                                    <MenuItem.Icon>
                                        <Viewbox Width="14" Height="14"><Path Data="{StaticResource IconDelete}" Fill="{DynamicResource DangerBrush}"/></Viewbox>
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Center: transfer arrows -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0">
                <Button Content="&#x2190;" Style="{StaticResource TransferArrowButton}" Margin="0,0,0,8"
                        Command="{Binding SendFromRightToRemoteCommand}"
                        ToolTip="{Binding SendLeftTooltip}"/>
                <Button Content="&#x2192;" Style="{StaticResource TransferArrowButton}"
                        Command="{Binding SendToRemoteCommand}"
                        ToolTip="{Binding SendRightTooltip}"/>
            </StackPanel>

            <!-- Right panel (remote or local) -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Margin="6,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Panel header -->
                    <Border Grid.Row="0" Background="{DynamicResource SurfaceAltBgBrush}" CornerRadius="10,10,0,0" Padding="12,8">
                        <TextBlock Text="{Binding RightPanelTitle}" FontWeight="SemiBold" FontSize="13"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </Border>

                    <!-- Toolbar -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="8,6,8,2">
                        <Button Style="{StaticResource ToolbarButton}" Command="{Binding HomeRightCommand}" ToolTip="{x:Static props:Strings.FileTransfer_Tooltip_Home}" MinWidth="32">
                            <Viewbox Width="14" Height="14"><Path Data="{StaticResource IconHome}" Fill="{DynamicResource TextSecondaryBrush}"/></Viewbox>
                        </Button>
                        <Button Style="{StaticResource ToolbarButton}" Command="{Binding ParentRightCommand}" ToolTip="{x:Static props:Strings.FileTransfer_Tooltip_Up}" MinWidth="32">
                            <Viewbox Width="14" Height="14"><Path Data="{StaticResource IconUp}" Fill="{DynamicResource TextSecondaryBrush}"/></Viewbox>
                        </Button>
                        <Button Style="{StaticResource ToolbarButton}" Command="{Binding RefreshRightCommand}" ToolTip="{x:Static props:Strings.FileTransfer_Tooltip_Refresh}" MinWidth="32">
                            <Viewbox Width="14" Height="14"><Path Data="{StaticResource IconRefresh}" Fill="{DynamicResource TextSecondaryBrush}"/></Viewbox>
                        </Button>
                        <Rectangle Width="1" Fill="{DynamicResource BorderBrush}" Margin="4,4"/>
                        <Button Style="{StaticResource ToolbarButton}" Command="{Binding CreateFolderRightCommand}" ToolTip="{x:Static props:Strings.FileTransfer_NewFolder}">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="14" Height="14" Margin="0,0,4,0"><Path Data="{StaticResource IconNewFolder}" Fill="#F0A030"/></Viewbox>
                                <TextBlock Text="{x:Static props:Strings.FileTransfer_Button_Folder}" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Button>
                        <ComboBox Width="120" MinHeight="30" FontSize="12" Margin="4,0,0,0" VerticalContentAlignment="Center"
                                  ItemsSource="{Binding SortOptions}"
                                  SelectedItem="{Binding RightSortOption}" ToolTip="{x:Static props:Strings.FileTransfer_Tooltip_Sort}"
                                  ItemTemplate="{StaticResource SortItemTemplate}"/>
                        <Rectangle Width="1" Fill="{DynamicResource BorderBrush}" Margin="4,4"/>
                        <Button Style="{StaticResource ToolbarButton}" MinWidth="24" ToolTip="{x:Static props:Strings.FileTransfer_View_Details}"
                                Click="ViewMode_Details"><TextBlock Text="&#x2630;" FontSize="13"/></Button>
                        <Button Style="{StaticResource ToolbarButton}" MinWidth="24" ToolTip="{x:Static props:Strings.FileTransfer_View_Small}"
                                Click="ViewMode_Small"><TextBlock Text="&#x2637;" FontSize="13"/></Button>
                        <Button Style="{StaticResource ToolbarButton}" MinWidth="24" ToolTip="{x:Static props:Strings.FileTransfer_View_Large}"
                                Click="ViewMode_Large"><TextBlock Text="&#x2B1A;" FontSize="13"/></Button>
                    </StackPanel>

                    <!-- Breadcrumb -->
                    <Border Grid.Row="2" Margin="8,4,8,6" Background="{DynamicResource SurfaceAltBgBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="6,4" MinHeight="28">
                        <ItemsControl ItemsSource="{Binding RightBreadcrumbs}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Label}"
                                                   MouseDown="RightBreadcrumb_Click" Tag="{Binding FullPath}"
                                                   ToolTip="{Binding FullPath}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource BreadcrumbLabel}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsLast}" Value="True">
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text=" &#x203A; " Foreground="{DynamicResource TextTertiaryBrush}" FontSize="12" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsLast}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <!-- File list with loading overlay -->
                    <Grid Grid.Row="3" Margin="4,0,4,6">
                        <ListBox x:Name="RightList" Style="{StaticResource FileListBox}"
                                 ItemsSource="{Binding RightItems}"
                                 SelectionMode="Extended" SelectionChanged="RightList_OnSelectionChanged"
                                 MouseDoubleClick="RightList_OnMouseDoubleClick"
                                 KeyDown="RightList_OnKeyDown" MouseMove="RightList_OnMouseMove"
                                 PreviewMouseDown="RightList_OnPreviewMouseDown"
                                 AllowDrop="True" Drop="RightList_OnDrop" DragOver="List_OnDragOver"
                                 ItemTemplate="{StaticResource FileItemDetailsTemplate}">
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{x:Static props:Strings.FileTransfer_ContextMenu_Properties}" Command="{Binding ShowPropertiesRightCommand}">
                                        <MenuItem.Icon>
                                            <Viewbox Width="14" Height="14"><Path Data="{StaticResource IconProperties}" Fill="{DynamicResource TextSecondaryBrush}"/></Viewbox>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="{x:Static props:Strings.FileTransfer_ContextMenu_Rename}" Command="{Binding RenameRightCommand}">
                                        <MenuItem.Icon><Viewbox Width="14" Height="14"><Path Data="{StaticResource IconRename}" Fill="{DynamicResource TextSecondaryBrush}"/></Viewbox></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="{x:Static props:Strings.FileTransfer_ContextMenu_CopyPath}" Command="{Binding CopyPathRightCommand}">
                                        <MenuItem.Icon><Viewbox Width="14" Height="14"><Path Data="{StaticResource IconCopyPath}" Fill="{DynamicResource TextSecondaryBrush}"/></Viewbox></MenuItem.Icon>
                                    </MenuItem>
                                    <Separator/>
                                    <MenuItem Header="{x:Static props:Strings.FileTransfer_ContextMenu_Delete}" Command="{Binding DeleteRightCommand}">
                                        <MenuItem.Icon>
                                            <Viewbox Width="14" Height="14"><Path Data="{StaticResource IconDelete}" Fill="{DynamicResource DangerBrush}"/></Viewbox>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </ListBox.ContextMenu>
                        </ListBox>
                        <!-- Loading spinner -->
                        <Border Background="{DynamicResource SurfaceBgBrush}" Opacity="0.82" CornerRadius="8"
                                Visibility="{Binding RightPanelLoading, Converter={StaticResource BoolToVis}}">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="&#x27F3;" FontSize="24" Foreground="{DynamicResource PrimaryBrush}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="{x:Static props:Strings.FileTransfer_Status_Loading}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="1" Margin="0,8,0,0" Padding="12,6" Background="{DynamicResource SurfaceBgBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding SelectionInfoText}" FontSize="11"
                           Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource TextSecondaryBrush}"
                           TextTrimming="CharacterEllipsis" FontSize="12" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- Transfer progress panel (Windows Explorer style) -->
        <Border Grid.Row="2" Margin="0,6,0,0" Style="{StaticResource Card}" Padding="14,10"
                DataContext="{Binding QueueProgress}">
            <Grid>
                <!-- Active transfer panel (hidden when summary shows) -->
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsActive}" Value="True"/>
                                        <Condition Binding="{Binding ShowSummary}" Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <!-- Header: "Файл N из M" -->
                    <DockPanel Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <!-- Pause (hidden when paused) -->
                            <Button Width="30" Height="28" Padding="0" Margin="0,0,4,0"
                                    Command="{Binding PauseAllCommand}" ToolTip="{x:Static props:Strings.FileTransfer_Button_Pause}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="&#x23F8;" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </Button>
                            <!-- Resume (visible when paused) -->
                            <Button Style="{StaticResource ToolbarButton}" Width="30" Height="28" Padding="0" Margin="0,0,4,0"
                                    Command="{Binding ResumeAllCommand}"
                                    Visibility="{Binding IsPaused, Converter={StaticResource BoolToVis}}"
                                    ToolTip="{x:Static props:Strings.FileTransfer_Button_Resume}">
                                <TextBlock Text="&#x25B6;" FontSize="13" Foreground="#2E7D32"/>
                            </Button>
                            <!-- Cancel -->
                            <Button Style="{StaticResource ToolbarButton}" Width="30" Height="28" Padding="0"
                                    Command="{Binding CancelAllCommand}" ToolTip="{x:Static props:Strings.FileTransfer_Button_CancelAll}">
                                <TextBlock Text="&#x2715;" FontSize="12" Foreground="#C62828"/>
                            </Button>
                        </StackPanel>
                        <TextBlock Text="{Binding StatusText}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </DockPanel>

                    <!-- Current file name -->
                    <TextBlock Text="{Binding CurrentFileName}" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis" Margin="0,0,0,6"/>

                    <!-- Progress bar -->
                    <ProgressBar Height="8" Minimum="0" Maximum="1"
                                 Value="{Binding OverallProgress, Mode=OneWay}"
                                 BorderThickness="0" Background="{DynamicResource BorderBrush}"
                                 Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,0,6"/>

                    <!-- Stats: size, speed, ETA -->
                    <DockPanel>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <TextBlock Text="{Binding SpeedText}" FontSize="11" FontFamily="Consolas"
                                       Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding EtaText}" FontSize="11"
                                       Foreground="{DynamicResource TextTertiaryBrush}"/>
                        </StackPanel>
                        <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}">
                            <Run Text="{Binding ProgressText, Mode=OneWay}"/>
                            <Run Text=" "/>
                            <Run Text="{Binding OverallPercent, Mode=OneWay, StringFormat=({0}%)}"/>
                        </TextBlock>
                    </DockPanel>
                </StackPanel>

                <!-- Summary after completion -->
                <TextBlock Text="{Binding SummaryText}" FontSize="12" Foreground="#2E7D32"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,6"
                           Visibility="{Binding ShowSummary, Converter={StaticResource BoolToVis}}"/>

                <!-- Idle state (no transfers) -->
                <TextBlock Text="{x:Static props:Strings.FileTransfer_Status_NoTransfers}" FontSize="12"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,8">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ShowSummary}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</Window>
