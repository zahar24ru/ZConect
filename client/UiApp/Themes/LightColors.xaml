<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ═══ Light theme: Colors ═══ -->
  <Color x:Key="PrimaryColor">#155FA2</Color>
  <Color x:Key="PrimaryHoverColor">#0F4A80</Color>
  <Color x:Key="WindowBgColor">#F3F7FC</Color>
  <Color x:Key="SurfaceBgColor">#FFFFFF</Color>
  <Color x:Key="SurfaceAltBgColor">#F6FAFF</Color>
  <Color x:Key="SurfaceAltBorderColor">#DDE8F5</Color>
  <Color x:Key="BorderColor">#D7E2EF</Color>
  <Color x:Key="SeparatorColor">#D7E2EF</Color>
  <Color x:Key="TextPrimaryColor">#1F2E3D</Color>
  <Color x:Key="TextSecondaryColor">#42586E</Color>
  <Color x:Key="PlaceholderColor">#9CA3AF</Color>
  <Color x:Key="TextTertiaryColor">#B8C0CC</Color>
  <Color x:Key="HostStatsColor">#506377</Color>
  <Color x:Key="HoverBgColor">#EAF3FF</Color>
  <Color x:Key="SelectedBgColor">#CFE3F8</Color>
  <Color x:Key="GradientStartColor">#F9FCFF</Color>
  <Color x:Key="GradientEndColor">#EAF3FF</Color>
  <Color x:Key="DangerColor">#E74C3C</Color>
  <Color x:Key="DangerBgColor">#C0392B</Color>
  <Color x:Key="DangerHoverColor">#A93226</Color>

  <!-- ═══ Light theme: Brushes ═══ -->
  <SolidColorBrush x:Key="PrimaryBrush"          Color="#155FA2"/>
  <SolidColorBrush x:Key="PrimaryHoverBrush"      Color="#0F4A80"/>
  <SolidColorBrush x:Key="WindowBgBrush"           Color="#F3F7FC"/>
  <SolidColorBrush x:Key="SurfaceBgBrush"          Color="#FFFFFF"/>
  <SolidColorBrush x:Key="SurfaceAltBgBrush"       Color="#F6FAFF"/>
  <SolidColorBrush x:Key="SurfaceAltBorderBrush"   Color="#DDE8F5"/>
  <SolidColorBrush x:Key="BorderBrush"              Color="#D7E2EF"/>
  <SolidColorBrush x:Key="SeparatorBrush"           Color="#D7E2EF"/>
  <SolidColorBrush x:Key="TextPrimaryBrush"         Color="#1F2E3D"/>
  <SolidColorBrush x:Key="TextSecondaryBrush"       Color="#42586E"/>
  <SolidColorBrush x:Key="PlaceholderBrush"         Color="#9CA3AF"/>
  <SolidColorBrush x:Key="TextTertiaryBrush"        Color="#B8C0CC"/>
  <SolidColorBrush x:Key="HostStatsBrush"           Color="#506377"/>
  <SolidColorBrush x:Key="HoverBgBrush"             Color="#EAF3FF"/>
  <SolidColorBrush x:Key="SelectedBgBrush"          Color="#CFE3F8"/>
  <SolidColorBrush x:Key="DangerBrush"              Color="#E74C3C"/>
  <SolidColorBrush x:Key="DangerBgBrush"            Color="#C0392B"/>
  <SolidColorBrush x:Key="DangerHoverBrush"         Color="#A93226"/>

</ResourceDictionary>
