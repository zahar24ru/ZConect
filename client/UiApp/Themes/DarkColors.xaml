<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ═══ Dark theme: Colors (softer dark blue-gray, not pitch-black) ═══ -->
  <Color x:Key="PrimaryColor">#2B7BD6</Color>
  <Color x:Key="PrimaryHoverColor">#3A8EE6</Color>
  <Color x:Key="WindowBgColor">#242838</Color>
  <Color x:Key="SurfaceBgColor">#2C3144</Color>
  <Color x:Key="SurfaceAltBgColor">#283048</Color>
  <Color x:Key="SurfaceAltBorderColor">#3A4058</Color>
  <Color x:Key="BorderColor">#3A4058</Color>
  <Color x:Key="SeparatorColor">#3A4058</Color>
  <Color x:Key="TextPrimaryColor">#E8ECF4</Color>
  <Color x:Key="TextSecondaryColor">#A0A8C0</Color>
  <Color x:Key="PlaceholderColor">#6B7394</Color>
  <Color x:Key="TextTertiaryColor">#6B7394</Color>
  <Color x:Key="HostStatsColor">#A0A8C0</Color>
  <Color x:Key="HoverBgColor">#363D58</Color>
  <Color x:Key="SelectedBgColor">#48507A</Color>
  <Color x:Key="GradientStartColor">#283048</Color>
  <Color x:Key="GradientEndColor">#2C3144</Color>
  <Color x:Key="DangerColor">#E74C3C</Color>
  <Color x:Key="DangerBgColor">#C0392B</Color>
  <Color x:Key="DangerHoverColor">#A93226</Color>

  <!-- ═══ Dark theme: Brushes ═══ -->
  <SolidColorBrush x:Key="PrimaryBrush"          Color="#2B7BD6"/>
  <SolidColorBrush x:Key="PrimaryHoverBrush"      Color="#3A8EE6"/>
  <SolidColorBrush x:Key="WindowBgBrush"           Color="#242838"/>
  <SolidColorBrush x:Key="SurfaceBgBrush"          Color="#2C3144"/>
  <SolidColorBrush x:Key="SurfaceAltBgBrush"       Color="#283048"/>
  <SolidColorBrush x:Key="SurfaceAltBorderBrush"   Color="#3A4058"/>
  <SolidColorBrush x:Key="BorderBrush"              Color="#3A4058"/>
  <SolidColorBrush x:Key="SeparatorBrush"           Color="#3A4058"/>
  <SolidColorBrush x:Key="TextPrimaryBrush"         Color="#E8ECF4"/>
  <SolidColorBrush x:Key="TextSecondaryBrush"       Color="#A0A8C0"/>
  <SolidColorBrush x:Key="PlaceholderBrush"         Color="#6B7394"/>
  <SolidColorBrush x:Key="TextTertiaryBrush"        Color="#6B7394"/>
  <SolidColorBrush x:Key="HostStatsBrush"           Color="#A0A8C0"/>
  <SolidColorBrush x:Key="HoverBgBrush"             Color="#363D58"/>
  <SolidColorBrush x:Key="SelectedBgBrush"          Color="#48507A"/>
  <SolidColorBrush x:Key="DangerBrush"              Color="#E74C3C"/>
  <SolidColorBrush x:Key="DangerBgBrush"            Color="#C0392B"/>
  <SolidColorBrush x:Key="DangerHoverBrush"         Color="#A93226"/>

</ResourceDictionary>
