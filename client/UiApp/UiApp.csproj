<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Target windows10.0.19041.0 чтобы иметь доступ к Windows.UI.Notifications
         ToastNotification API для настоящих system toast'ов в правом нижнем углу
         (аналог Windows 10/11 native notification). Минимальная Win10 версия
         19041 (2004) — это baseline для всех активных Win10 installs. -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <AssemblyName>ZConnect</AssemblyName>
    <Product>ZConnect</Product>
    <AssemblyTitle>ZConnect</AssemblyTitle>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>1.0.1</Version>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="ZConect.Tests" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="app.ico" />
  </ItemGroup>
  <!-- Localization — neutral resource assembly "Strings.resx" (Russian default)
       plus satellite assembly per культура. NeutralResourcesLanguage уже указывает что
       primary = ru-RU (Русский), чтобы нейтральная resx использовалась если user
       system locale ru-RU. -->
  <PropertyGroup>
    <NeutralLanguage>ru-RU</NeutralLanguage>
  </PropertyGroup>
  <!-- .resx auto-included SDK. Явно только Compile dependency (чтобы Strings.Designer.cs
       показывался nested под Strings.resx в Solution Explorer). Generator НЕ указан
       чтобы SDK не пытался regenerate auto-file — наш Strings.Designer.cs
       hand-maintained. -->
  <ItemGroup>
    <Compile Update="Properties\Strings.Designer.cs">
      <DependentUpon>Strings.resx</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\FileTransfer\FileTransfer.csproj" />
    <ProjectReference Include="..\QualityController\QualityController.csproj" />
    <ProjectReference Include="..\ScreenCapture\ScreenCapture.csproj" />
    <ProjectReference Include="..\SessionClient\SessionClient.csproj" />
    <ProjectReference Include="..\WebRtcTransport\WebRtcTransport.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="4.2.0" />
  </ItemGroup>

  <!-- Ensure native mrwebrtc.dll is present for runtime loading.
       NuGet ships it under runtimes/win10-x64/native, but some RID graphs don't copy it automatically. -->
  <Target Name="CopyMrWebrtcNative" AfterTargets="Build;Publish">
    <PropertyGroup>
      <!-- NuGetPackageRoot is not always populated under nested build hosts; UserProfile is stable on Windows. -->
      <_MrWebrtcSrc>$(UserProfile)\.nuget\packages\microsoft.mixedreality.webrtc\2.0.2\runtimes\win10-x64\native\mrwebrtc.dll</_MrWebrtcSrc>
      <_MrWebrtcDstBuild>$(OutDir)mrwebrtc.dll</_MrWebrtcDstBuild>
      <_MrWebrtcDstPublish Condition="'$(PublishDir)' != ''">$(PublishDir)mrwebrtc.dll</_MrWebrtcDstPublish>
    </PropertyGroup>

    <Message Importance="High" Text="mrwebrtc: copy from $(_MrWebrtcSrc) to $(_MrWebrtcDstBuild)" Condition="Exists('$(_MrWebrtcSrc)')" />
    <Message Importance="High" Text="mrwebrtc: source not found at $(_MrWebrtcSrc) (WebRTC will fallback to mock)" Condition="!Exists('$(_MrWebrtcSrc)')" />
    <Copy SourceFiles="$(_MrWebrtcSrc)" DestinationFiles="$(_MrWebrtcDstBuild)" Condition="Exists('$(_MrWebrtcSrc)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(_MrWebrtcSrc)" DestinationFiles="$(_MrWebrtcDstPublish)" Condition="Exists('$(_MrWebrtcSrc)') and '$(_MrWebrtcDstPublish)' != ''" SkipUnchangedFiles="true" />
  </Target>
</Project>
