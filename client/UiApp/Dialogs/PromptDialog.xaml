<Window x:Class="UiApp.Dialogs.PromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:props="clr-namespace:UiApp.Properties"
        Title="{x:Static props:Strings.Dialog_Title_SaveConnection}"
        SizeToContent="Height"
        Width="380"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBgBrush}">
    <Border Padding="20">
        <StackPanel>
            <TextBlock x:Name="TitleText"
                       Text="{x:Static props:Strings.Dialog_PromptTitle}"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       Margin="0,0,0,8"/>
            <TextBlock x:Name="MessageText"
                       Text="{x:Static props:Strings.Dialog_PromptMessage}"
                       TextWrapping="Wrap"
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       LineHeight="18"
                       Margin="0,0,0,14"/>
            <TextBox x:Name="NameBox"
                     Height="36"
                     Padding="10,6"
                     FontSize="14"
                     MaxLength="64"
                     BorderBrush="{DynamicResource BorderBrush}"
                     BorderThickness="1"
                     Background="{DynamicResource SurfaceBgBrush}"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     KeyDown="NameBox_KeyDown"/>
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,18,0,0">
                <Button x:Name="LaterButton"
                        Content="{x:Static props:Strings.Button_Later}"
                        MinWidth="90"
                        Height="36"
                        Padding="14,6"
                        Margin="0,0,10,0"
                        Style="{DynamicResource SecondaryButtonStyle}"
                        IsCancel="True"
                        Click="LaterButton_Click"/>
                <Button x:Name="SaveButton"
                        Content="{x:Static props:Strings.Button_Save}"
                        MinWidth="100"
                        Height="36"
                        Padding="14,6"
                        Style="{DynamicResource PrimaryButtonStyle}"
                        IsDefault="True"
                        Click="SaveButton_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
