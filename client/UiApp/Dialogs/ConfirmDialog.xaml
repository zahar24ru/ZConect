<Window x:Class="UiApp.Dialogs.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:props="clr-namespace:UiApp.Properties"
        Title="{x:Static props:Strings.Dialog_Title_Confirm}"
        SizeToContent="Height"
        Width="340"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBgBrush}">
    <Border Padding="20">
        <StackPanel>
            <TextBlock x:Name="MessageText"
                       TextWrapping="Wrap"
                       FontSize="14"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       LineHeight="22"/>
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,20,0,0">
                <Button x:Name="CancelButton"
                        Content="{x:Static props:Strings.Button_Cancel}"
                        MinWidth="90"
                        Height="36"
                        Padding="16,6"
                        Margin="0,0,10,0"
                        Style="{DynamicResource SecondaryButtonStyle}"
                        IsCancel="True"
                        Click="CancelButton_Click"/>
                <Button x:Name="ConfirmButton"
                        MinWidth="90"
                        Height="36"
                        Padding="16,6"
                        Style="{DynamicResource DangerButtonStyle}"
                        Click="ConfirmButton_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
