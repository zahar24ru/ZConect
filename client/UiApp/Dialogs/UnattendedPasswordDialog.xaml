<Window x:Class="UiApp.Dialogs.UnattendedPasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:props="clr-namespace:UiApp.Properties"
        Title="{x:Static props:Strings.Dialog_Title_UnattendedPassword}"
        SizeToContent="Height"
        Width="400"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBgBrush}">
    <Border Padding="20">
        <StackPanel>
            <TextBlock Text="{x:Static props:Strings.Dialog_Password_Hint}"
                       FontSize="14" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       Margin="0,0,0,8"/>
            <TextBlock Text="{x:Static props:Strings.Dialog_Password_Hint2}"
                       TextWrapping="Wrap"
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       LineHeight="18"
                       Margin="0,0,0,16"/>

            <!-- Retry / error message (shown on subsequent attempts) -->
            <Border x:Name="RetryBanner"
                    Visibility="Collapsed"
                    Background="#33EF4444"
                    BorderBrush="#EF4444"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="10,6"
                    Margin="0,0,0,12">
                <TextBlock x:Name="RetryText"
                           TextWrapping="Wrap"
                           FontSize="12"
                           Foreground="#FCA5A5"/>
            </Border>

            <TextBlock Text="{x:Static props:Strings.LabelPassword}"
                       FontSize="11"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,0,0,4"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <PasswordBox x:Name="PasswordBox"
                             Grid.Column="0"
                             Height="32"
                             Padding="8,6"
                             FontSize="13"
                             BorderBrush="{DynamicResource BorderBrush}"
                             BorderThickness="1"
                             PasswordChanged="PasswordBox_PasswordChanged"
                             KeyDown="PasswordInput_KeyDown"/>
                <TextBox x:Name="PasswordTextBox"
                         Grid.Column="0"
                         Visibility="Collapsed"
                         Height="32"
                         Padding="8,6"
                         FontSize="13"
                         BorderBrush="{DynamicResource BorderBrush}"
                         BorderThickness="1"
                         TextChanged="PasswordTextBox_TextChanged"
                         KeyDown="PasswordInput_KeyDown"/>
                <Button Grid.Column="1"
                        x:Name="TogglePasswordVisibilityButton"
                        MinWidth="44" MinHeight="32"
                        Padding="8,0"
                        Margin="6,0,0,0"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Content="👁"
                        FontSize="14"
                        ToolTip="{x:Static props:Strings.Dialog_Password_ToggleTooltip}"
                        Click="TogglePasswordVisibility_Click"/>
            </Grid>
            <TextBlock x:Name="LengthHint"
                       Text="{x:Static props:Strings.Dialog_Password_MinLength}"
                       FontSize="11"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,4,0,0"/>

            <CheckBox x:Name="RememberPasswordCheckBox"
                      Visibility="Collapsed"
                      Content="{x:Static props:Strings.Dialog_RememberPassword_Checkbox}"
                      Margin="0,10,0,0"
                      FontSize="12"
                      Foreground="{DynamicResource TextSecondaryBrush}"
                      ToolTip="{x:Static props:Strings.Dialog_RememberPassword_Tooltip}"/>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,20,0,0">
                <Button x:Name="WaitButton"
                        Content="{x:Static props:Strings.Button_RequestPermission}"
                        MinWidth="140"
                        Height="36"
                        Padding="12,6"
                        Margin="0,0,10,0"
                        Style="{DynamicResource SecondaryButtonStyle}"
                        IsCancel="True"
                        Click="WaitButton_Click"/>
                <Button x:Name="ConnectButton"
                        Content="{x:Static props:Strings.Button_Connect}"
                        MinWidth="110"
                        Height="36"
                        Padding="12,6"
                        Style="{DynamicResource PrimaryButtonStyle}"
                        IsDefault="True"
                        IsEnabled="False"
                        Click="ConnectButton_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
