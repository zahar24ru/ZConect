<Window x:Class="UiApp.Dialogs.UnattendedPasswordSetupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:props="clr-namespace:UiApp.Properties"
        Title="{x:Static props:Strings.Dialog_Title_SetPassword}"
        SizeToContent="Height"
        Width="400"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBgBrush}">
    <Border Padding="20">
        <StackPanel>
            <TextBlock Text="{x:Static props:Strings.Dialog_SetPassword_Heading}"
                       FontSize="14" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       Margin="0,0,0,8"/>
            <TextBlock Text="{x:Static props:Strings.Dialog_SetPassword_Hint}"
                       TextWrapping="Wrap"
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       LineHeight="18"
                       Margin="0,0,0,16"/>

            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{x:Static props:Strings.Dialog_SetPassword_NewPassword}"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <Button Grid.Column="1"
                        x:Name="ToggleShowButton"
                        Content="{x:Static props:Strings.Dialog_SetPassword_ShowButton}"
                        FontSize="11"
                        Padding="6,1"
                        MinWidth="90"
                        ToolTip="{x:Static props:Strings.Dialog_SetPassword_Toggle_Tooltip}"
                        Click="ToggleShow_Click"/>
            </Grid>
            <Grid>
                <PasswordBox x:Name="Pwd1"
                             Height="32"
                             Padding="8,6"
                             FontSize="13"
                             BorderBrush="{DynamicResource BorderBrush}"
                             BorderThickness="1"
                             PasswordChanged="Pwd_Changed"/>
                <TextBox x:Name="Pwd1Visible"
                         Visibility="Collapsed"
                         Height="32"
                         Padding="8,6"
                         FontSize="13"
                         BorderBrush="{DynamicResource BorderBrush}"
                         BorderThickness="1"
                         TextChanged="Pwd_Changed"/>
            </Grid>

            <!-- Password strength bar: Grid ColumnDefinitions with Star units
                 обеспечивает корректное заполнение 0..100% независимо от фактической
                 ширины контейнера (без хардкода pixel'ов). -->
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Height="4" CornerRadius="2"
                        Background="{DynamicResource BorderBrush}"
                        VerticalAlignment="Center"
                        ClipToBounds="True">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="StrengthFillColumn" Width="0*"/>
                            <ColumnDefinition x:Name="StrengthEmptyColumn" Width="100*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="StrengthFill"
                                Grid.Column="0"
                                CornerRadius="2"
                                Background="#9CA3AF"/>
                    </Grid>
                </Border>
                <TextBlock Grid.Column="1"
                           x:Name="StrengthLabel"
                           Text=""
                           FontSize="11"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </Grid>

            <TextBlock Text="{x:Static props:Strings.Dialog_SetPassword_ConfirmLabel}"
                       FontSize="11"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,10,0,4"/>
            <Grid>
                <PasswordBox x:Name="Pwd2"
                             Height="32"
                             Padding="8,6"
                             FontSize="13"
                             BorderBrush="{DynamicResource BorderBrush}"
                             BorderThickness="1"
                             PasswordChanged="Pwd_Changed"/>
                <TextBox x:Name="Pwd2Visible"
                         Visibility="Collapsed"
                         Height="32"
                         Padding="8,6"
                         FontSize="13"
                         BorderBrush="{DynamicResource BorderBrush}"
                         BorderThickness="1"
                         TextChanged="Pwd_Changed"/>
            </Grid>

            <TextBlock x:Name="StatusText"
                       Text="{x:Static props:Strings.Dialog_Password_MinLength}"
                       FontSize="11"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,8,0,0"
                       TextWrapping="Wrap"/>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,20,0,0">
                <Button x:Name="CancelButton"
                        Content="{x:Static props:Strings.Button_Cancel}"
                        MinWidth="90"
                        Height="36"
                        Padding="16,6"
                        Margin="0,0,10,0"
                        Style="{DynamicResource SecondaryButtonStyle}"
                        IsCancel="True"
                        Click="CancelButton_Click"/>
                <Button x:Name="SaveButton"
                        Content="{x:Static props:Strings.Button_Save}"
                        MinWidth="100"
                        Height="36"
                        Padding="16,6"
                        Style="{DynamicResource PrimaryButtonStyle}"
                        IsDefault="True"
                        IsEnabled="False"
                        Click="SaveButton_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
