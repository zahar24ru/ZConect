<Window x:Class="UiApp.SystemSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ZConnect — Настройки"
        MinWidth="520"
        MinHeight="480"
        Width="620"
        Height="700"
        Background="#F3F7FC"
        WindowStartupLocation="CenterOwner"
        Icon="app.ico">
    <Grid Margin="14">
        <Border Background="#FFFFFF"
                CornerRadius="14"
                BorderBrush="#D7E2EF"
                BorderThickness="1"
                Padding="14">
            <TabControl>

                <!-- Приложение -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="14" Height="14" Margin="0,0,6,0">
                                <Path Data="M9.405 1.05c-.413-1.4-2.397-1.4-2.81 0l-.1.34a1.464 1.464 0 0 1-2.105.872l-.31-.17c-1.283-.698-2.686.705-1.987 1.987l.169.311c.446.82.023 1.841-.872 2.105l-.34.1c-1.4.413-1.4 2.397 0 2.81l.34.1a1.464 1.464 0 0 1 .872 2.105l-.17.31c-.698 1.283.705 2.686 1.987 1.987l.311-.169a1.464 1.464 0 0 1 2.105.872l.1.34c.413 1.4 2.397 1.4 2.81 0l.1-.34a1.464 1.464 0 0 1 2.105-.872l.31.17c1.283.698 2.686-.705 1.987-1.987l-.169-.311a1.464 1.464 0 0 1 .872-2.105l.34-.1c1.4-.413 1.4-2.397 0-2.81l-.34-.1a1.464 1.464 0 0 1-.872-2.105l.17-.31c.698-1.283-.705-2.686-1.987-1.987l-.311.169a1.464 1.464 0 0 1-2.105-.872l-.1-.34zM8 10.93a2.929 2.929 0 1 1 0-5.86 2.929 2.929 0 0 1 0 5.858z"
                                      Fill="{StaticResource PrimaryBrush}"/>
                            </Viewbox>
                            <TextBlock Text="Приложение" VerticalAlignment="Center"/>
                        </StackPanel>
                    </TabItem.Header>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="8">

                            <TextBlock Text="Запуск" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <CheckBox Content="Запускать при загрузке Windows" Margin="0,8,0,0"
                                      Foreground="{StaticResource TextSecondaryBrush}"
                                      IsChecked="{Binding AutoStartOnBoot}"
                                      ToolTip="Добавить приложение в автозагрузку Windows (реестр CurrentUser\Run)"/>
                            <CheckBox Content="Автоматически создавать сессию при запуске" Margin="0,6,0,0"
                                      Foreground="{StaticResource TextSecondaryBrush}"
                                      IsChecked="{Binding AutoCreateSession}"
                                      ToolTip="При запуске приложения сессия создаётся автоматически без нажатия кнопки"/>
                            <CheckBox Content="Сворачивать в трей при закрытии (вместо выхода)" Margin="0,6,0,0"
                                      Foreground="{StaticResource TextSecondaryBrush}"
                                      IsChecked="{Binding MinimizeToTray}"
                                      ToolTip="Крестик скрывает окно в трей. Для полного выхода — ZConnect → Выход"/>

                            <Separator Margin="0,14,0,8" Background="#D7E2EF"/>

                            <TextBlock Text="Язык" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <ComboBox Width="200" Height="28"
                                          ItemsSource="{Binding AvailableLanguages}"
                                          SelectedItem="{Binding SelectedLanguage}"
                                          ToolTip="Выбор языка интерфейса (в разработке)"/>
                                <TextBlock Text="(в разработке)" Foreground="#9CA3AF" FontSize="11"
                                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </StackPanel>

                            <Separator Margin="0,14,0,8" Background="#D7E2EF"/>

                            <TextBlock Text="Сессия" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <CheckBox Content="Разрешить подключение без подтверждения" Margin="0,8,0,0"
                                      Foreground="{StaticResource TextSecondaryBrush}"
                                      IsChecked="{Binding AllowUnattended}"
                                      ToolTip="Зритель из адресной книги подключается без диалога подтверждения на хосте"/>
                            <CheckBox Content="Только передача файлов (без удалённого стола)" Margin="0,6,0,0"
                                      Foreground="{StaticResource TextSecondaryBrush}"
                                      IsChecked="{Binding FileTransferOnly}"
                                      ToolTip="Видеопоток не включается при подключении — только файловый обмен"/>

                            <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                                <TextBlock Text="Время жизни сессии:"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="0,0,8,0"/>
                                <ComboBox Width="200" Height="28"
                                          ItemsSource="{Binding UnattendedDurationOptions}"
                                          DisplayMemberPath="Label"
                                          SelectedValuePath="Seconds"
                                          SelectedValue="{Binding SelectedUnattendedExpiresInSec}"
                                          ToolTip="Через это время сессия истечёт. Автообновление при 20% оставшегося времени"/>
                            </StackPanel>

                            <Separator Margin="0,14,0,8" Background="#D7E2EF"/>

                            <TextBlock Text="Качество и экран" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Качество видео"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="12" Margin="0,0,0,2"/>
                                    <ComboBox Height="30"
                                              IsEditable="False"
                                              ItemsSource="{Binding HostAvailableQualityPresets}"
                                              SelectedItem="{Binding QualityPreset, UpdateSourceTrigger=PropertyChanged}"
                                              ToolTip="Auto — подстраивается под канал. Low/Medium/High — фиксированный пресет"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Монитор"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="12" Margin="0,0,0,2"/>
                                    <ComboBox Height="30"
                                              ItemsSource="{Binding AvailableDisplayIds}"
                                              SelectedItem="{Binding DisplayId, UpdateSourceTrigger=PropertyChanged}"
                                              ToolTip="Какой монитор транслировать. All — все мониторы в одном потоке"/>
                                </StackPanel>
                            </Grid>

                            <Separator Margin="0,14,0,8" Background="#D7E2EF"/>

                            <TextBlock Text="ID" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBox Text="{Binding MachineId, Mode=OneWay}" IsReadOnly="True"
                                     Margin="0,4,0,0"
                                     Padding="8,6"
                                     FontFamily="Consolas"
                                     FontSize="12"
                                     Style="{StaticResource ReadOnlyTextBoxStyle}"
                                     ToolTip="Уникальный ID этой машины. Используется для переиспользования сессии после перезапуска"/>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Сервер -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="14" Height="14" Margin="0,0,6,0">
                                <Path Data="M2 2 C1 2 0 3 0 4 V12 C0 13 1 14 2 14 H14 C15 14 16 13 16 12 V4 C16 3 15 2 14 2 Z M2 4 H14 V6 H2 Z M2 7 H7 V12 H2 Z M9 7 H14 V12 H9 Z"
                                      Fill="{StaticResource PrimaryBrush}"/>
                            </Viewbox>
                            <TextBlock Text="Сервер" VerticalAlignment="Center"/>
                        </StackPanel>
                    </TabItem.Header>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="8">

                            <TextBlock Text="Адреса подключения" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>

                            <TextBlock Text="Server API URL"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="12" Margin="0,8,0,2"/>
                            <TextBox Text="{Binding ServerApiBaseUrl, UpdateSourceTrigger=PropertyChanged}"
                                     Height="30"
                                     ToolTip="HTTP-адрес сигнального сервера для создания/присоединения к сессиям"/>

                            <TextBlock Text="WebSocket URL"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="12" Margin="0,8,0,2"/>
                            <TextBox Text="{Binding WebSocketUrl, UpdateSourceTrigger=PropertyChanged}"
                                     Height="30"
                                     ToolTip="WS-адрес для обмена SDP/ICE между хостом и зрителем"/>

                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="Проверить подключение"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Height="32" Padding="14,0"
                                        Command="{Binding TestServerConnectionCommand}"
                                        ToolTip="Отправить GET /healthz и показать результат"/>
                                <TextBlock Text="{Binding ServerTestResult}"
                                           Foreground="{Binding ServerTestBrush}"
                                           VerticalAlignment="Center"
                                           FontWeight="SemiBold"
                                           Margin="10,0,0,0"/>
                            </StackPanel>

                            <Separator Margin="0,14,0,8" Background="#D7E2EF"/>

                            <TextBlock Text="STUN / TURN" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>

                            <TextBlock Text="STUN URL"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="12" Margin="0,8,0,2"/>
                            <TextBox Text="{Binding StunUrl, UpdateSourceTrigger=PropertyChanged}"
                                     Height="30"
                                     ToolTip="STUN-сервер для определения публичного IP. Формат: stun:host:port"/>

                            <TextBlock Text="TURN URL"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="12" Margin="0,8,0,2"/>
                            <TextBox Text="{Binding TurnUrl, UpdateSourceTrigger=PropertyChanged}"
                                     Height="30"
                                     ToolTip="TURN-сервер для ретрансляции трафика через NAT. Формат: turn:host:port"/>

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="TURN Username"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="12" Margin="0,0,0,2"/>
                                    <TextBox Text="{Binding TurnUsername, UpdateSourceTrigger=PropertyChanged}"
                                             Height="30"
                                             ToolTip="Имя пользователя для аутентификации на TURN-сервере"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="TURN Password"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="12" Margin="0,0,0,2"/>
                                    <TextBox Text="{Binding TurnPassword, UpdateSourceTrigger=PropertyChanged}"
                                             Height="30"
                                             ToolTip="Пароль для аутентификации на TURN-сервере"/>
                                </StackPanel>
                            </Grid>

                            <Separator Margin="0,14,0,8" Background="#D7E2EF"/>

                            <TextBlock Margin="0,4,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="#9CA3AF"
                                       FontSize="11"
                                       Text="Подключение автоматическое: все методы (LAN, STUN, TURN) используются одновременно для максимальной скорости. После подключения путь оптимизируется в фоне."/>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Логи -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="14" Height="14" Margin="0,0,6,0">
                                <Path Data="M2 0 C0.9 0 0 0.9 0 2 V14 C0 15.1 0.9 16 2 16 H14 C15.1 16 16 15.1 16 14 V2 C16 0.9 15.1 0 14 0 Z M3 3 H13 V5 H3 Z M3 7 H13 V9 H3 Z M3 11 H9 V13 H3 Z"
                                      Fill="{StaticResource PrimaryBrush}"/>
                            </Viewbox>
                            <TextBlock Text="Логи" VerticalAlignment="Center"/>
                        </StackPanel>
                    </TabItem.Header>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="8">

                            <TextBlock Text="Фильтры DEBUG-логов" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="Управление категориями шумных DEBUG-сообщений. Изменения применяются сразу."
                                       Margin="0,6,0,10"
                                       TextWrapping="Wrap"
                                       Foreground="#9CA3AF"
                                       FontSize="12"/>

                            <CheckBox Content="DataChannel Input (mouse/keyboard dc_sent/dc_recv)"
                                      Margin="0,4,0,0"
                                      Foreground="{StaticResource TextSecondaryBrush}"
                                      IsChecked="{Binding DebugLogDataChannelInputEnabled}"
                                      ToolTip="Логи отправки/приёма событий мыши и клавиатуры"/>
                            <CheckBox Content="Clipboard (ClipboardSync + DataChannel Clipboard)"
                                      Margin="0,4,0,0"
                                      Foreground="{StaticResource TextSecondaryBrush}"
                                      IsChecked="{Binding DebugLogClipboardEnabled}"
                                      ToolTip="Логи синхронизации буфера обмена"/>
                            <CheckBox Content="Signaling + WS (Signaling и UiApp ws_message_*)"
                                      Margin="0,4,0,0"
                                      Foreground="{StaticResource TextSecondaryBrush}"
                                      IsChecked="{Binding DebugLogSignalingEnabled}"
                                      ToolTip="Логи WebSocket-обмена: SDP, ICE, peer_state"/>
                            <CheckBox Content="WebRTC"
                                      Margin="0,4,0,0"
                                      Foreground="{StaticResource TextSecondaryBrush}"
                                      IsChecked="{Binding DebugLogWebRtcEnabled}"
                                      ToolTip="Низкоуровневые логи WebRTC: соединение, кодеки, ICE"/>

                            <Separator Margin="0,14,0,8" Background="#D7E2EF"/>

                            <TextBlock Text="Файлы логов" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding LogFileSizeText}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,6,0,10"/>

                            <StackPanel Orientation="Horizontal">
                                <Button Content="Открыть файл логов"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Height="32" Padding="14,0"
                                        Click="OpenLogFile_Click"
                                        ToolTip="Открыть logs.log в редакторе по умолчанию"/>
                                <Button Content="Очистить логи"
                                        Style="{StaticResource DangerButtonStyle}"
                                        Height="32" Padding="14,0"
                                        Margin="8,0,0,0"
                                        Click="ClearLogFiles_Click"
                                        ToolTip="Удалить все файлы логов (logs.log и ротированные)"/>
                            </StackPanel>

                            <Separator Margin="0,14,0,8" Background="#D7E2EF"/>

                            <TextBlock Text="ICE Debug" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="Текущее состояние ICE-маршрута (обновляется в реальном времени при активном подключении)."
                                       Margin="0,6,0,8"
                                       TextWrapping="Wrap"
                                       Foreground="#9CA3AF"
                                       FontSize="12"/>
                            <TextBox Text="{Binding IcePathText, Mode=OneWay}"
                                     IsReadOnly="True"
                                     FontFamily="Consolas"
                                     FontSize="12"
                                     Padding="8,6"
                                     Foreground="{Binding IcePathBrush}"
                                     Style="{StaticResource ReadOnlyTextBoxStyle}"
                                     ToolTip="Тип ICE-маршрута: LAN, WAN (STUN) или Relay (TURN)"/>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- О программе -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="14" Height="14" Margin="0,0,6,0">
                                <Path Data="M8 0 C3.6 0 0 3.6 0 8 C0 12.4 3.6 16 8 16 C12.4 16 16 12.4 16 8 C16 3.6 12.4 0 8 0 Z M8 3 C8.8 3 9.5 3.7 9.5 4.5 C9.5 5.3 8.8 6 8 6 C7.2 6 6.5 5.3 6.5 4.5 C6.5 3.7 7.2 3 8 3 Z M10 13 H6 V12 H7 V8 H6 V7 H9 V12 H10 Z"
                                      Fill="{StaticResource PrimaryBrush}"/>
                            </Viewbox>
                            <TextBlock Text="О программе" VerticalAlignment="Center"/>
                        </StackPanel>
                    </TabItem.Header>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="8" HorizontalAlignment="Center" VerticalAlignment="Center">

                            <TextBlock Text="ZConnect" FontSize="28" FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryBrush}"
                                       HorizontalAlignment="Center" Margin="0,20,0,4"/>
                            <TextBlock Text="v1.0.0" FontSize="14"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center" Margin="0,0,0,16"/>

                            <Separator Margin="40,0" Background="#D7E2EF"/>

                            <TextBlock TextWrapping="Wrap" TextAlignment="Center"
                                       Margin="20,16,20,0"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="13"
                                       LineHeight="20">
                                Удалённый рабочий стол и передача файлов.
                                <LineBreak/>
                                Открытый проект для быстрого удалённого доступа
                                <LineBreak/>
                                через WebRTC с минимальной задержкой.
                            </TextBlock>

                            <Separator Margin="40,16,40,0" Background="#D7E2EF"/>

                            <StackPanel Margin="0,16,0,0" HorizontalAlignment="Center">
                                <TextBlock FontSize="12" Foreground="#9CA3AF" HorizontalAlignment="Center">
                                    <Run Text="Платформа:"/>
                                    <Hyperlink NavigateUri="https://dotnet.microsoft.com/en-us/apps/desktop"
                                               RequestNavigate="Hyperlink_RequestNavigate">.NET 8 + WPF</Hyperlink>
                                </TextBlock>
                                <TextBlock FontSize="12" Foreground="#9CA3AF" HorizontalAlignment="Center" Margin="0,4,0,0">
                                    <Run Text="Захват:"/>
                                    <Hyperlink NavigateUri="https://learn.microsoft.com/en-us/windows/win32/direct3ddxgi/dx-graphics-dxgi"
                                               RequestNavigate="Hyperlink_RequestNavigate">DXGI Desktop Duplication</Hyperlink>
                                </TextBlock>
                                <TextBlock FontSize="12" Foreground="#9CA3AF" HorizontalAlignment="Center" Margin="0,4,0,0">
                                    <Run Text="Транспорт:"/>
                                    <Hyperlink NavigateUri="https://github.com/sipsorcery-org/sipsorcery"
                                               RequestNavigate="Hyperlink_RequestNavigate">WebRTC (SIPSorcery)</Hyperlink>
                                </TextBlock>
                                <TextBlock FontSize="12" Foreground="#9CA3AF" HorizontalAlignment="Center" Margin="0,4,0,0">
                                    <Run Text="Сервер:"/>
                                    <Hyperlink NavigateUri="https://go.dev"
                                               RequestNavigate="Hyperlink_RequestNavigate">Go</Hyperlink>
                                    <Run Text="+"/>
                                    <Hyperlink NavigateUri="https://github.com/gorilla/websocket"
                                               RequestNavigate="Hyperlink_RequestNavigate">Gorilla WebSocket</Hyperlink>
                                </TextBlock>
                            </StackPanel>

                            <Separator Margin="40,16,40,0" Background="#D7E2EF"/>

                            <StackPanel Margin="0,14,0,0" HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                                    <TextBlock Text="Сайт:" FontSize="12" Foreground="#9CA3AF"
                                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock FontSize="12">
                                        <Hyperlink NavigateUri="http://localhost"
                                                   RequestNavigate="Hyperlink_RequestNavigate">http://localhost</Hyperlink>
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                                    <TextBlock Text="GitHub:" FontSize="12" Foreground="#9CA3AF"
                                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock FontSize="12">
                                        <Hyperlink NavigateUri="https://github.com/zahar24ru/ZConect"
                                                   RequestNavigate="Hyperlink_RequestNavigate">github.com/zahar24ru/ZConect</Hyperlink>
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                                    <TextBlock Text="VK:" FontSize="12" Foreground="#9CA3AF"
                                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock FontSize="12">
                                        <Hyperlink NavigateUri="https://vk.com/zahar24rus"
                                                   RequestNavigate="Hyperlink_RequestNavigate">vk.com/zahar24rus</Hyperlink>
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                                    <TextBlock Text="Telegram:" FontSize="12" Foreground="#9CA3AF"
                                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock FontSize="12">
                                        <Hyperlink NavigateUri="https://t.me/zahar24ru"
                                                   RequestNavigate="Hyperlink_RequestNavigate">t.me/zahar24ru</Hyperlink>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Text="© 2026 ZConnect"
                                       FontSize="11" Foreground="#9CA3AF"
                                       HorizontalAlignment="Center"
                                       Margin="0,14,0,4"/>

                            <TextBlock FontSize="10" Foreground="#B8C0CC" FontStyle="Italic"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,10">
                                <Run Text="Сделано с помощью вайб-кодинга:"/>
                                <Hyperlink NavigateUri="https://claude.ai"
                                           RequestNavigate="Hyperlink_RequestNavigate"
                                           Foreground="#B8C0CC">Claude AI</Hyperlink>
                                <Run Text="+"/>
                                <Hyperlink NavigateUri="https://cursor.com"
                                           RequestNavigate="Hyperlink_RequestNavigate"
                                           Foreground="#B8C0CC">Cursor</Hyperlink>
                                <Run Text="🤙"/>
                            </TextBlock>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

            </TabControl>
        </Border>
    </Grid>
</Window>
