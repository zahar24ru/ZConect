<Window x:Class="UiApp.SystemSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:props="clr-namespace:UiApp.Properties"
        Title="{x:Static props:Strings.SettingsWindowTitle}"
        MinWidth="520"
        MinHeight="480"
        Width="620"
        Height="700"
        Background="{DynamicResource WindowBgBrush}"
        WindowStartupLocation="Manual"
        Icon="app.ico">
    <Grid Margin="14">
        <Border Background="{DynamicResource SurfaceBgBrush}"
                CornerRadius="14"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                Padding="14"
                Effect="{DynamicResource CardShadow}">
            <TabControl>

                <!-- Приложение -->
                <TabItem Margin="2,0,0,0">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="14" Height="14" Margin="0,0,6,0">
                                <Path Data="M9.405 1.05c-.413-1.4-2.397-1.4-2.81 0l-.1.34a1.464 1.464 0 0 1-2.105.872l-.31-.17c-1.283-.698-2.686.705-1.987 1.987l.169.311c.446.82.023 1.841-.872 2.105l-.34.1c-1.4.413-1.4 2.397 0 2.81l.34.1a1.464 1.464 0 0 1 .872 2.105l-.17.31c-.698 1.283.705 2.686 1.987 1.987l.311-.169a1.464 1.464 0 0 1 2.105.872l.1.34c.413 1.4 2.397 1.4 2.81 0l.1-.34a1.464 1.464 0 0 1 2.105-.872l.31.17c1.283.698 2.686-.705 1.987-1.987l-.169-.311a1.464 1.464 0 0 1 .872-2.105l.34-.1c1.4-.413 1.4-2.397 0-2.81l-.34-.1a1.464 1.464 0 0 1-.872-2.105l.17-.31c.698-1.283-.705-2.686-1.987-1.987l-.311.169a1.464 1.464 0 0 1-2.105-.872l-.1-.34zM8 10.93a2.929 2.929 0 1 1 0-5.86 2.929 2.929 0 0 1 0 5.858z"
                                      Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/>
                            </Viewbox>
                            <TextBlock Text="{x:Static props:Strings.Settings_Tab_Application}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </TabItem.Header>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="8">

                            <TextBlock Text="{x:Static props:Strings.SettingsLanguageLabel}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <ComboBox x:Name="LanguageCombo" Width="200" Height="34"
                                          SelectionChanged="LanguageCombo_SelectionChanged"
                                          ToolTip="{x:Static props:Strings.Settings_Language_Tooltip}"/>
                                <TextBlock Text="{x:Static props:Strings.SettingsLanguageHint}" Foreground="{DynamicResource PlaceholderBrush}" FontSize="11"
                                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </StackPanel>

                            <!-- ════════════════ SESSION ════════════════ -->
                            <Separator Margin="0,18,0,10" Background="{DynamicResource SeparatorBrush}"/>
                            <TextBlock Text="{x:Static props:Strings.Settings_Session_Label}" FontWeight="SemiBold"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <CheckBox Content="{x:Static props:Strings.Settings_AutoCreate}" Margin="0,10,0,0"
                                      Foreground="{DynamicResource TextSecondaryBrush}"
                                      IsChecked="{Binding AutoCreateSession}"
                                      ToolTip="{x:Static props:Strings.Settings_AutoCreate_Tooltip}"/>
                            <CheckBox Content="{x:Static props:Strings.Settings_FileTransferOnly}" Margin="0,6,0,0"
                                      Foreground="{DynamicResource TextSecondaryBrush}"
                                      IsChecked="{Binding FileTransferOnly}"
                                      ToolTip="{x:Static props:Strings.Settings_FileTransferOnly_Tooltip}"/>
                            <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                                <TextBlock Text="{x:Static props:Strings.Settings_SessionDuration}"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,0,8,0"/>
                                <ComboBox Width="200" Height="34"
                                          ItemsSource="{Binding UnattendedDurationOptions}"
                                          DisplayMemberPath="Label"
                                          SelectedValuePath="Seconds"
                                          SelectedValue="{Binding SelectedUnattendedExpiresInSec}"
                                          ToolTip="{x:Static props:Strings.Settings_SessionDuration_Tooltip}"/>
                            </StackPanel>

                            <!-- ════════════════ UPDATES ════════════════ -->
                            <Separator Margin="0,18,0,10" Background="{DynamicResource SeparatorBrush}"/>
                            <TextBlock Text="{x:Static props:Strings.Settings_Updates_Label}" FontWeight="SemiBold"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <CheckBox Content="{x:Static props:Strings.Settings_AutoUpdate}" Margin="0,10,0,0"
                                      Foreground="{DynamicResource TextSecondaryBrush}"
                                      IsChecked="{Binding AutoUpdateCheckEnabled}"
                                      ToolTip="{x:Static props:Strings.Settings_AutoUpdate_Tooltip}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
                                <Button x:Name="CheckUpdateNowButton"
                                        Style="{DynamicResource SecondaryButtonStyle}"
                                        MinHeight="32"
                                        Padding="14,4"
                                        Click="CheckUpdateNow_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Viewbox Width="13" Height="13" Margin="0,0,6,0">
                                            <!-- refresh / reload icon -->
                                            <Path Data="M8 3 V1 L4 4 L8 7 V5 C10.21 5 12 6.79 12 9 C12 11.21 10.21 13 8 13 C5.79 13 4 11.21 4 9 H2 C2 12.31 4.69 15 8 15 C11.31 15 14 12.31 14 9 C14 5.69 11.31 3 8 3 Z"
                                                  Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                        </Viewbox>
                                        <TextBlock Text="{x:Static props:Strings.Button_CheckUpdateNow}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <TextBlock x:Name="CheckUpdateResult"
                                           VerticalAlignment="Center"
                                           Margin="10,0,0,0"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>

                            <!-- ════════════════ SECURITY ════════════════ -->
                            <Separator Margin="0,18,0,10" Background="{DynamicResource SeparatorBrush}"/>
                            <TextBlock Text="{x:Static props:Strings.Settings_Security_Label}" FontWeight="SemiBold"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <!-- Unattended password card — выделенный блок с status и actions.
                                 Card-style: subtle background + border + padding для visual grouping.
                                 Note: ранее была отдельная checkbox "Разрешить подключение без
                                 подтверждения", но user case 2026-04-26 показал что её случайно
                                 снимают после установки password → password gate отключается.
                                 Single source of truth теперь: password set ⇒ unattended on. -->
                            <Border Margin="0,10,0,0"
                                    Padding="14,12"
                                    Background="{DynamicResource WindowBgBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                <StackPanel>
                                    <!-- Card title hint -->
                                    <TextBlock Text="{x:Static props:Strings.Settings_Unattended_Card_Title}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Margin="0,0,0,8"/>
                                    <!-- Status row: lock icon + status text -->
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,10">
                                        <TextBlock x:Name="UnattendedPasswordStatus"
                                                   VerticalAlignment="Center"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   Text="{x:Static props:Strings.Settings_Unattended_Status_NotRequired}"/>
                                    </StackPanel>
                                    <!-- Actions row: Set/Change (primary) + Delete (secondary outline, only when set) -->
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="SetUnattendedPasswordButton"
                                                Content="{x:Static props:Strings.Settings_SetPassword}"
                                                Style="{DynamicResource PrimaryButtonStyle}"
                                                MinHeight="32"
                                                Padding="16,4"
                                                Margin="0,0,8,0"
                                                Click="SetUnattendedPassword_Click"/>
                                        <Button x:Name="ClearUnattendedPasswordButton"
                                                Content="{x:Static props:Strings.Button_Delete}"
                                                Style="{DynamicResource SecondaryButtonStyle}"
                                                Foreground="{DynamicResource DangerBrush}"
                                                BorderBrush="{DynamicResource DangerBrush}"
                                                MinHeight="32"
                                                Padding="16,4"
                                                Click="ClearUnattendedPassword_Click"/>
                                    </StackPanel>
                                    <!-- Lockout warning (visible только при active lockout) -->
                                    <StackPanel x:Name="LockoutWarningPanel"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center"
                                                Margin="0,10,0,0"
                                                Visibility="Collapsed">
                                        <TextBlock x:Name="LockoutWarningText"
                                                   VerticalAlignment="Center"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource DangerBrush}"
                                                   Margin="0,0,10,0"
                                                   Text="{x:Static props:Strings.Settings_LockoutActive}"/>
                                        <Button x:Name="ResetLockoutButton"
                                                Content="{x:Static props:Strings.Settings_ResetLockout}"
                                                Style="{DynamicResource SecondaryButtonStyle}"
                                                Foreground="{DynamicResource DangerBrush}"
                                                BorderBrush="{DynamicResource DangerBrush}"
                                                MinHeight="30"
                                                Padding="14,4"
                                                ToolTip="{x:Static props:Strings.Settings_ResetLockout_Tooltip}"
                                                Click="ResetLockout_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- ════════════════ DEVICE ID ════════════════ -->
                            <Separator Margin="0,18,0,10" Background="{DynamicResource SeparatorBrush}"/>
                            <TextBlock Text="{x:Static props:Strings.Settings_ID_Label}" FontWeight="SemiBold"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBox Text="{Binding MachineId, Mode=OneWay}" IsReadOnly="True"
                                     Margin="0,8,0,0"
                                     Padding="8,6"
                                     FontFamily="Consolas"
                                     FontSize="12"
                                     Style="{DynamicResource ReadOnlyTextBoxStyle}"
                                     ToolTip="{x:Static props:Strings.Settings_ID_Tooltip}"/>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Сервер -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="14" Height="14" Margin="0,0,6,0">
                                <Path Data="M2 2 C1 2 0 3 0 4 V12 C0 13 1 14 2 14 H14 C15 14 16 13 16 12 V4 C16 3 15 2 14 2 Z M2 4 H14 V6 H2 Z M2 7 H7 V12 H2 Z M9 7 H14 V12 H9 Z"
                                      Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/>
                            </Viewbox>
                            <TextBlock Text="{x:Static props:Strings.Settings_Tab_Server}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </TabItem.Header>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="8">

                            <TextBlock Text="{x:Static props:Strings.Settings_ServerAddresses}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>

                            <TextBlock Text="Server API URL"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="12" Margin="0,8,0,2"/>
                            <TextBox Text="{Binding ServerApiBaseUrl, UpdateSourceTrigger=PropertyChanged}"
                                     Height="30"
                                     ToolTip="{x:Static props:Strings.Settings_ServerAPI_Tooltip}"/>

                            <TextBlock Text="WebSocket URL"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="12" Margin="0,8,0,2"/>
                            <TextBox Text="{Binding WebSocketUrl, UpdateSourceTrigger=PropertyChanged}"
                                     Height="30"
                                     ToolTip="{x:Static props:Strings.Settings_WebSocket_Tooltip}"/>

                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="{x:Static props:Strings.Button_TestConnection}"
                                        Style="{DynamicResource SecondaryButtonStyle}"
                                        Height="32" Padding="14,0"
                                        Command="{Binding TestServerConnectionCommand}"
                                        ToolTip="{x:Static props:Strings.Button_TestConnection_Tooltip}"/>
                                <TextBlock Text="{Binding ServerTestResult}"
                                           Foreground="{Binding ServerTestBrush}"
                                           VerticalAlignment="Center"
                                           FontWeight="SemiBold"
                                           Margin="10,0,0,0"/>
                            </StackPanel>

                            <Separator Margin="0,14,0,8" Background="{DynamicResource SeparatorBrush}"/>

                            <TextBlock Text="{x:Static props:Strings.Settings_STUN_TURN_Label}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>

                            <!-- TURN status badge — Variant C UI redesign 2026-04-25.
                                 Показывает live состояние rotating creds (приходят от сервера),
                                 либо статус static config'а если rotating не активна. -->
                            <Border Background="{DynamicResource CardSurfaceBrush}"
                                    BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1"
                                    Padding="10,8" CornerRadius="6" Margin="0,8,0,0">
                                <StackPanel>
                                    <!-- Indicator dot (Ellipse) + status text. Раньше использовал emoji
                                         🟢/🟡/⚪ в строке, но WPF TextBlock рендерит их monochrome
                                         (color emoji не поддерживается). Заменил на solid-color Ellipse. -->
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="10" Height="10"
                                                 Fill="{Binding TurnStatusBrush}"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding TurnStatusText}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   FontWeight="SemiBold" FontSize="13"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <!-- Live details (только когда rotating активна): URL + username + countdown -->
                                    <StackPanel Margin="0,6,0,0"
                                                Visibility="{Binding IsTurnRotationActive, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Grid Margin="0,2,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="{x:Static props:Strings.Settings_TURN_Live_Url_Label}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       FontSize="11"/>
                                            <TextBlock Grid.Column="1" Text="{Binding TurnLiveUrl}"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       FontFamily="Consolas" FontSize="11"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                        <Grid Margin="0,2,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="{x:Static props:Strings.Settings_TURN_Live_Username_Label}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       FontSize="11"/>
                                            <TextBlock Grid.Column="1" Text="{Binding TurnLiveUsername}"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       FontFamily="Consolas" FontSize="11"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                        <Grid Margin="0,2,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="{x:Static props:Strings.Settings_TURN_Expires_Label}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       FontSize="11"/>
                                            <TextBlock Grid.Column="1" Text="{Binding TurnExpiresInText}"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       FontFamily="Consolas" FontSize="11"/>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="STUN URL"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="12" Margin="0,10,0,2"/>
                            <TextBox Text="{Binding StunUrl, UpdateSourceTrigger=PropertyChanged}"
                                     Height="30"
                                     ToolTip="{x:Static props:Strings.Settings_STUN_Tooltip}"/>

                            <!-- Custom TURN configuration — collapsed by default. Заполнять только
                                 если используется кастомный TURN сервер, не наш prod с rotating. -->
                            <Expander Header="{x:Static props:Strings.Settings_TURN_Custom_Header}"
                                      Foreground="{DynamicResource TextSecondaryBrush}"
                                      Margin="0,12,0,0"
                                      IsExpanded="False">
                                <StackPanel Margin="0,8,0,0">
                                    <TextBlock Text="{x:Static props:Strings.Settings_TURN_Custom_Hint}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"/>

                                    <TextBlock Text="TURN URL"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="12" Margin="0,4,0,2"/>
                                    <TextBox Text="{Binding TurnUrl, UpdateSourceTrigger=PropertyChanged}"
                                             Height="30"
                                             ToolTip="{x:Static props:Strings.Settings_TURN_Tooltip}"/>

                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="TURN Username"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       FontSize="12" Margin="0,0,0,2"/>
                                            <TextBox Text="{Binding TurnUsername, UpdateSourceTrigger=PropertyChanged}"
                                                     Height="30"
                                                     ToolTip="{x:Static props:Strings.Settings_TURN_Username_Tooltip}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="TURN Password"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       FontSize="12" Margin="0,0,0,2"/>
                                            <TextBox Text="{Binding TurnPassword, UpdateSourceTrigger=PropertyChanged}"
                                                     Height="30"
                                                     ToolTip="{x:Static props:Strings.Settings_TURN_Password_Tooltip}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Expander>

                            <Separator Margin="0,14,0,8" Background="{DynamicResource SeparatorBrush}"/>

                            <TextBlock Text="{x:Static props:Strings.Settings_Diagnostics_Label}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Margin="0,0,0,4"/>

                            <CheckBox Content="{x:Static props:Strings.Settings_ForceRelay}"
                                      Margin="0,4,0,0"
                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                      IsChecked="{Binding PreferRelay}"
                                      ToolTip="{x:Static props:Strings.Settings_ForceRelay_Tooltip}"/>

                            <CheckBox Content="{x:Static props:Strings.Settings_DisableTURN}"
                                      Margin="0,4,0,0"
                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                      IsChecked="{Binding PreferLanVpnNoTurn}"
                                      ToolTip="{x:Static props:Strings.Settings_DisableTURN_Tooltip}"/>

                            <Separator Margin="0,14,0,8" Background="{DynamicResource SeparatorBrush}"/>

                            <TextBlock Margin="0,4,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource PlaceholderBrush}"
                                       FontSize="11"
                                       Text="{x:Static props:Strings.Settings_AutoConnection_Hint}"/>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Логи -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="14" Height="14" Margin="0,0,6,0">
                                <Path Data="M2 0 C0.9 0 0 0.9 0 2 V14 C0 15.1 0.9 16 2 16 H14 C15.1 16 16 15.1 16 14 V2 C16 0.9 15.1 0 14 0 Z M3 3 H13 V5 H3 Z M3 7 H13 V9 H3 Z M3 11 H9 V13 H3 Z"
                                      Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/>
                            </Viewbox>
                            <TextBlock Text="{x:Static props:Strings.Settings_Tab_Logs}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </TabItem.Header>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="8">

                            <TextBlock Text="{x:Static props:Strings.Settings_Debug_Filters_Label}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{x:Static props:Strings.Settings_Debug_Filters_Hint}"
                                       Margin="0,6,0,10"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource PlaceholderBrush}"
                                       FontSize="12"/>

                            <CheckBox Content="DataChannel Input (mouse/keyboard dc_sent/dc_recv)"
                                      Margin="0,4,0,0"
                                      Foreground="{DynamicResource TextSecondaryBrush}"
                                      IsChecked="{Binding DebugLogDataChannelInputEnabled}"
                                      ToolTip="{x:Static props:Strings.Settings_DebugFilter_DCInput_Tooltip}"/>
                            <CheckBox Content="Clipboard (ClipboardSync + DataChannel Clipboard)"
                                      Margin="0,4,0,0"
                                      Foreground="{DynamicResource TextSecondaryBrush}"
                                      IsChecked="{Binding DebugLogClipboardEnabled}"
                                      ToolTip="{x:Static props:Strings.Settings_DebugFilter_Clipboard_Tooltip}"/>
                            <CheckBox Content="Signaling + WS (Signaling и UiApp ws_message_*)"
                                      Margin="0,4,0,0"
                                      Foreground="{DynamicResource TextSecondaryBrush}"
                                      IsChecked="{Binding DebugLogSignalingEnabled}"
                                      ToolTip="{x:Static props:Strings.Settings_DebugFilter_Signaling_Tooltip}"/>
                            <CheckBox Content="WebRTC"
                                      Margin="0,4,0,0"
                                      Foreground="{DynamicResource TextSecondaryBrush}"
                                      IsChecked="{Binding DebugLogWebRtcEnabled}"
                                      ToolTip="{x:Static props:Strings.Settings_DebugFilter_WebRTC_Tooltip}"/>

                            <Separator Margin="0,14,0,8" Background="{DynamicResource SeparatorBrush}"/>

                            <TextBlock Text="{x:Static props:Strings.Settings_LogFiles_Label}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding LogFileSizeText}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,6,0,10"/>

                            <StackPanel Orientation="Horizontal">
                                <Button Content="{x:Static props:Strings.Button_OpenLogFile}"
                                        Style="{DynamicResource SecondaryButtonStyle}"
                                        Height="32" Padding="14,0"
                                        Click="OpenLogFile_Click"
                                        ToolTip="{x:Static props:Strings.Button_OpenLogFile_Tooltip}"/>
                                <Button Content="{x:Static props:Strings.Button_ClearLogFiles}"
                                        Style="{DynamicResource DangerButtonStyle}"
                                        Height="32" Padding="14,0"
                                        Margin="8,0,0,0"
                                        Click="ClearLogFiles_Click"
                                        ToolTip="{x:Static props:Strings.Button_ClearLogFiles_Tooltip}"/>
                            </StackPanel>

                            <Separator Margin="0,14,0,8" Background="{DynamicResource SeparatorBrush}"/>

                            <TextBlock Text="{x:Static props:Strings.Settings_ICE_Debug_Label}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{x:Static props:Strings.Settings_ICE_Debug_Hint}"
                                       Margin="0,6,0,8"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource PlaceholderBrush}"
                                       FontSize="12"/>
                            <TextBox Text="{Binding IcePathText, Mode=OneWay}"
                                     IsReadOnly="True"
                                     FontFamily="Consolas"
                                     FontSize="12"
                                     Padding="8,6"
                                     Foreground="{Binding IcePathBrush}"
                                     Style="{DynamicResource ReadOnlyTextBoxStyle}"
                                     ToolTip="{x:Static props:Strings.Settings_ICE_Debug_Tooltip}"/>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- О программе -->
                <TabItem Margin="0,0,2,0">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="14" Height="14" Margin="0,0,6,0">
                                <Path Data="M8 0 C3.6 0 0 3.6 0 8 C0 12.4 3.6 16 8 16 C12.4 16 16 12.4 16 8 C16 3.6 12.4 0 8 0 Z M8 3 C8.8 3 9.5 3.7 9.5 4.5 C9.5 5.3 8.8 6 8 6 C7.2 6 6.5 5.3 6.5 4.5 C6.5 3.7 7.2 3 8 3 Z M10 13 H6 V12 H7 V8 H6 V7 H9 V12 H10 Z"
                                      Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/>
                            </Viewbox>
                            <TextBlock Text="{x:Static props:Strings.Settings_Tab_About}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </TabItem.Header>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="8" HorizontalAlignment="Center" VerticalAlignment="Center">

                            <TextBlock Text="ZConnect" FontSize="28" FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryBrush}"
                                       HorizontalAlignment="Center" Margin="0,20,0,4"/>
                            <TextBlock x:Name="AboutVersionText" FontSize="14"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center" Margin="0,0,0,4"/>
                            <TextBlock x:Name="AboutBuildText" FontSize="11"
                                       Foreground="{DynamicResource PlaceholderBrush}"
                                       HorizontalAlignment="Center" Margin="0,0,0,16"/>

                            <Separator Margin="40,0" Background="{DynamicResource SeparatorBrush}"/>

                            <TextBlock TextWrapping="Wrap" TextAlignment="Center"
                                       Margin="20,16,20,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="13"
                                       LineHeight="20">
                                <Run Text="{x:Static props:Strings.Settings_About_Intro_Line1}"/>
                                <LineBreak/>
