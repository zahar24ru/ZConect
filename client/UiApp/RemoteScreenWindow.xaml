<Window x:Class="UiApp.RemoteScreenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:props="clr-namespace:UiApp.Properties"
        Title="{x:Static props:Strings.RemoteScreen_Title}"
        Icon="app.ico"
        MinWidth="640"
        MinHeight="420"
        Background="#0A0A0F"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <!-- Color palette -->
        <SolidColorBrush x:Key="BarBg" Color="#14141F"/>
        <SolidColorBrush x:Key="BarBorder" Color="#2A2A3D"/>
        <SolidColorBrush x:Key="CtrlBg" Color="#1E1E2E"/>
        <SolidColorBrush x:Key="CtrlBorder" Color="#363650"/>
        <SolidColorBrush x:Key="CtrlHover" Color="#2A2A44"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#6366F1"/>
        <SolidColorBrush x:Key="AccentHover" Color="#818CF8"/>
        <SolidColorBrush x:Key="TextBright" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="TextDim" Color="#94A3B8"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#EF4444"/>
        <SolidColorBrush x:Key="DangerHover" Color="#F87171"/>

        <!-- Toolbar button -->
        <Style x:Key="TBarBtn" TargetType="Button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource TextBright}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{StaticResource CtrlBg}" BorderBrush="{StaticResource CtrlBorder}"
                                BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource CtrlHover}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Accent button -->
        <Style x:Key="TBarAccentBtn" TargetType="Button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{StaticResource AccentBrush}" BorderThickness="0" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger button (Ctrl+Alt+Del) -->
        <Style x:Key="TBarDangerBtn" TargetType="Button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="#7F1D1D" BorderBrush="{StaticResource DangerBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource DangerBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox/ComboBoxItem — use dark Wpf.Ui theme for this window.
             Override the global Light theme with a local Dark style. -->
        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="Background" Value="#1E1E2E"/>
            <Setter Property="BorderBrush" Value="#363650"/>
            <Setter Property="MinHeight" Value="30"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="{StaticResource BarBg}"
                BorderBrush="{StaticResource BarBorder}" BorderThickness="0,0,0,1" Padding="10,6">
            <DockPanel>
                <!-- Left side: controls -->
                <StackPanel Orientation="Horizontal">
                    <!-- Quality -->
                    <TextBlock Text="{x:Static props:Strings.RemoteScreen_Quality_Label}" Foreground="{StaticResource TextDim}" FontSize="11"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox Width="130" MinHeight="30" Margin="0,0,10,0"
                              ItemsSource="{Binding ViewerAvailableQualityPresets}"
                              SelectedItem="{Binding ViewerRequestedQualityPreset, UpdateSourceTrigger=PropertyChanged}"/>

                    <!-- Display -->
                    <TextBlock Text="{x:Static props:Strings.RemoteScreen_Display_Label}" Foreground="{StaticResource TextDim}" FontSize="11"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox Width="160" MinHeight="30" Margin="0,0,10,0"
                              ItemsSource="{Binding ViewerAvailableDisplayIds}"
                              SelectedItem="{Binding ViewerRequestedDisplayId, UpdateSourceTrigger=PropertyChanged}"/>

                    <!-- Separator -->
                    <Rectangle Width="1" Fill="{StaticResource BarBorder}" Margin="4,4,14,4"/>

                    <!-- File Transfer -->
                    <Button Style="{StaticResource TBarBtn}" Margin="0,0,6,0"
                            Command="{Binding SendFileCommand}"
                            ToolTip="{x:Static props:Strings.RemoteScreen_FileTransfer_Tooltip}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x1F4C2;" FontSize="13" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{x:Static props:Strings.Button_FileTransfer}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Separator -->
                    <Rectangle Width="1" Fill="{StaticResource BarBorder}" Margin="4,4,14,4"/>

                    <!-- Apply -->
                    <Button Style="{StaticResource TBarAccentBtn}" Margin="0,0,6,0"
                            Command="{Binding ApplyRemoteVideoSettingsCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x2713;" FontSize="13" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{x:Static props:Strings.Button_Apply}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Quick Reconnect -->
                    <Button Style="{StaticResource TBarBtn}"
                            Command="{Binding QuickReconnectViewerCommand}"
                            ToolTip="{x:Static props:Strings.Button_Reconnect_Tooltip}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x27F3;" FontSize="14" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{x:Static props:Strings.Button_Reconnect}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Separator -->
                    <Rectangle Width="1" Fill="{StaticResource BarBorder}" Margin="14,4,14,4"/>

                    <!-- Task Manager — primary remote support action. Viewer шлёт DC
                         launch_process {name:"taskmgr"} → host whitelists → service
                         (SYSTEM) делает CreateProcessAsUser под active console user'а
                         на Default desktop. Taskmgr появляется в video feed. -->
                    <Button Style="{StaticResource TBarBtn}"
                            Command="{Binding LaunchTaskManagerCommand}"
                            ToolTip="{x:Static props:Strings.Button_TaskManager_Tooltip}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x1F4CA;" FontSize="13" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{x:Static props:Strings.Button_TaskManager}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Remote screen surface -->
        <Grid Grid.Row="1" x:Name="RemoteScreenSurface"
              Background="Transparent"
              Cursor="{Binding RemoteCursor}"
              Focusable="True"
              MouseMove="RemoteScreenSurface_OnMouseMove"
              MouseDown="RemoteScreenSurface_OnMouseDown"
              MouseUp="RemoteScreenSurface_OnMouseUp"
              MouseWheel="RemoteScreenSurface_OnMouseWheel"
              PreviewKeyDown="RemoteScreenSurface_OnPreviewKeyDown"
              PreviewKeyUp="RemoteScreenSurface_OnPreviewKeyUp"
              LostKeyboardFocus="RemoteScreenSurface_OnLostKeyboardFocus">
            <Image Source="{Binding RemoteFrameImage}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>

            <!-- Quality overlay (top-right pill) — FPS/bitrate/RTT.
                 Toggle via Ctrl+I (persist в ClientSettings.ShowQualityOverlay).
                 Ctrl+Shift+I — extended ICE route info line. -->
            <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,6,10,0" Padding="10,5" CornerRadius="12"
                    Background="#C0101020" IsHitTestVisible="False">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding VideoStatsText}" Value="">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ShowQualityOverlay}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="{Binding VideoStatsText}"
                               Foreground="#B0E2E8F0" FontSize="11" FontFamily="Consolas"/>
                    <TextBlock Text="{Binding IceDetailsText}"
                               Foreground="#909AB0C8" FontSize="10" FontFamily="Consolas"
                               Margin="0,2,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowIceDetailsOverlay}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Connection status overlay (center, shown when not connected) -->
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    Padding="24,16" CornerRadius="12" Background="#E0101020"
                    IsHitTestVisible="False">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding RemoteFrameImage}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="&#x27F3;" FontSize="28" Foreground="{StaticResource AccentBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{x:Static props:Strings.RemoteScreen_WaitingForVideo}" FontSize="13"
                               Foreground="{StaticResource TextDim}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
