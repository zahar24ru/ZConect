<Window x:Class="UiApp.RemoteScreenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ZConnect — Удалённый экран"
        Icon="app.ico"
        MinWidth="640"
        MinHeight="420"
        Background="#111111"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#1A1A1A" Padding="8">
            <StackPanel Orientation="Horizontal">
                <ComboBox Width="120"
                          Margin="0,0,8,0"
                          IsEditable="False"
                          ItemsSource="{Binding ViewerAvailableQualityPresets}"
                          SelectedItem="{Binding ViewerRequestedQualityPreset, UpdateSourceTrigger=PropertyChanged}"/>
                <ComboBox Width="180"
                          Margin="0,0,8,0"
                          ItemsSource="{Binding ViewerAvailableDisplayIds}"
                          SelectedItem="{Binding ViewerRequestedDisplayId, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Width="140"
                        Height="28"
                        Margin="0,0,8,0"
                        Content="Применить"
                        Command="{Binding ApplyRemoteVideoSettingsCommand}"/>
                <Button Width="170"
                        Height="28"
                        Margin="0,0,8,0"
                        Content="Быстрый реконнект"
                        Command="{Binding QuickReconnectViewerCommand}"/>
                <Button Width="110"
                        Height="28"
                        Content="Ctrl+Alt+Del"
                        Command="{Binding SendCtrlAltDelCommand}"
                        ToolTip="Отправить Ctrl+Alt+Del на удалённую машину"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" x:Name="RemoteScreenSurface"
              Background="Transparent"
              Cursor="{Binding RemoteCursor}"
              Focusable="True"
              MouseMove="RemoteScreenSurface_OnMouseMove"
              MouseDown="RemoteScreenSurface_OnMouseDown"
              MouseUp="RemoteScreenSurface_OnMouseUp"
              MouseWheel="RemoteScreenSurface_OnMouseWheel"
              PreviewKeyDown="RemoteScreenSurface_OnPreviewKeyDown"
              PreviewKeyUp="RemoteScreenSurface_OnPreviewKeyUp"
              LostKeyboardFocus="RemoteScreenSurface_OnLostKeyboardFocus">
            <Image Source="{Binding RemoteFrameImage}" Stretch="Uniform"/>

            <!-- Video stats overlay -->
            <Border HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,4,8,0"
                    Padding="6,3"
                    CornerRadius="4"
                    Background="#88000000"
                    IsHitTestVisible="False">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding VideoStatsText}" Value="">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding VideoStatsText}"
                           Foreground="#CCFFFFFF"
                           FontSize="12"
                           FontFamily="Consolas"/>
            </Border>
        </Grid>
    </Grid>
</Window>

